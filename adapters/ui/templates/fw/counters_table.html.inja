{% if length(counters) > 0 %}
<table class="data-table">
  <thead>
    <tr>
      <th class="right">id</th>
      <th class="right">packets</th>
      <th class="right">bytes</th>
    </tr>
  </thead>
  <tbody>
{% for c in counters %}
    <tr>
      <td class="right">{{ c.id }}</td>
      <td class="right">{{ c.packets }}</td>
      <td class="right">{{ c.bytes }}</td>
    </tr>
{% endfor %}
  </tbody>
</table>
{% else %}
<div class="empty">no counters active</div>
{% endif %}
