<div class="grid-2col">
  <section class="card">
    <h2 class="card-title">status</h2>
    <div class="card-body">
      <table class="data-table">
        <tbody>
          <tr>
            <td>daemon</td>
            <td>
{% if daemon.connected %}
              <span class="badge badge-good">connected</span>
{% else %}
              <span class="badge badge-bad">disconnected</span>
{% endif %}
            </td>
          </tr>
{% if existsIn(daemon, "uptime_s") %}
          <tr>
            <td>uptime</td>
            <td>{{ daemon.uptime_s }}s</td>
          </tr>
{% endif %}
{% if existsIn(daemon, "pid") %}
          <tr>
            <td>pid</td>
            <td>{{ daemon.pid }}</td>
          </tr>
{% endif %}
        </tbody>
      </table>
    </div>
  </section>

  <section class="card">
    <h2 class="card-title">firewall</h2>
    <div class="card-body">
      <table class="data-table">
        <tbody>
          <tr>
            <td>filtering on</td>
            <td>
              <span class="badge badge-{{ datapath_semantic }}">{{ attached_count }} of {{ iface_count }}</span>
            </td>
          </tr>
{% if not datapath_armed %}
          <tr>
            <td>datapath</td>
            <td>NOT armed — no interface has an XDP program attached; traffic is not being inspected</td>
          </tr>
{% endif %}
        </tbody>
      </table>
    </div>
  </section>

  <section class="card">
    <h2 class="card-title">zones &amp; NAT</h2>
    <div class="card-body">
      <table class="data-table">
        <tbody>
          <tr>
            <td>zones</td>
            <td>{{ zone_count }}</td>
          </tr>
          <tr>
            <td>NAT translations</td>
            <td>{{ nat_count }}</td>
          </tr>
{% if has_masq %}
          <tr>
            <td>masquerade source</td>
            <td class="mono">{{ masq_source }}</td>
          </tr>
{% endif %}
          <tr>
            <td>tracked connections</td>
            <td>{{ conntrack_count }}</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</div>
