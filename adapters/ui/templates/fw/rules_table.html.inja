{% if existsIn(at("."), "error") %}
<div class="empty">{{ error }}</div>
{% else if length(rules) > 0 %}
<table class="data-table">
  <thead>
    <tr>
      <th class="right">#</th>
      <th>src</th>
      <th>dst</th>
      <th>proto</th>
      <th class="right">sport</th>
      <th class="right">dport</th>
      <th>action</th>
      <th class="right">packets</th>
      <th class="right">bytes</th>
    </tr>
  </thead>
  <tbody>
{% for r in rules %}
    <tr>
      <td class="right dim">{{ r.idx }}</td>
      <td class="mono">{{ r.src }}</td>
      <td class="mono">{{ r.dst }}</td>
      <td>{{ r.proto }}</td>
      <td class="right">{{ r.src_port == 0 ? "*" : r.src_port }}</td>
      <td class="right">{{ r.dst_port == 0 ? "*" : r.dst_port }}</td>
      <td><span class="badge badge-{{ r.action_semantic }}">{{ r.action }}</span></td>
      <td class="right">{{ r.packets }}</td>
      <td class="right">{{ r.bytes }}</td>
    </tr>
{% endfor %}
  </tbody>
</table>
{% else %}
<div class="empty">no rules loaded</div>
{% endif %}
