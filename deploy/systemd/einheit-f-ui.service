[Unit]
Description=f firewall web dashboard
Documentation=man:einheit-f-ui(8)
After=fd.service network.target
Wants=fd.service

[Service]
Type=simple
# Loopback, deliberately — see the comment in cmd/einheit_f_ui.cc.
# This process authenticates nobody and cannot serve TLS, and what it
# renders is the entire firewall state. It bound 0.0.0.0 until
# 2026-08-16, and firstboot's generated policy admitted 443 on the
# uplink zone, so a stock box served its ruleset, zone topology, NAT
# table and live conntrack to the internet.
#
# Reach it over an SSH tunnel:
#   ssh -L 8443:127.0.0.1:443 <box>   then http://127.0.0.1:8443/
#
# Do NOT widen this back to 0.0.0.0 to "make the dashboard work". The
# thing that makes it safe to expose is authentication and TLS, and
# neither exists yet.
ExecStart=/usr/local/bin/einheit-f-ui \
    --bind 127.0.0.1 \
    --port 443 \
    --socket ipc:///run/f/control.sock \
    --templates /usr/share/einheit-ui/templates \
    --assets /usr/share/einheit-ui/assets
Restart=on-failure
RestartSec=3s

User=www-data
Group=www-data

# There is deliberately no `SupplementaryGroups=f`. There was, and
# nothing on any box has ever created a group called `f`, so systemd
# failed at step GROUP with status 216 before exec — on every start,
# forever, at RestartSec=3s. `systemctl is-active` says "activating"
# rather than "failed" while a unit is in auto-restart, which is how a
# dashboard that had never once served a page read as coming up.
#
# It would also have granted nothing. The data this process shows
# arrives over /run/f/control.sock, and fd's pins under /sys/fs/bpf/f
# are 0700 root with no group ownership for anything to inherit. If
# the pins are ever given a group, the group and this line get added
# in the same change.

# Hardening.
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/sys/fs/bpf/f
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

# Allow binding to port 443.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

StandardOutput=journal
StandardError=journal
SyslogIdentifier=einheit-f-ui

[Install]
WantedBy=multi-user.target
