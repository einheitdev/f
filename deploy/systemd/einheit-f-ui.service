[Unit]
Description=f firewall web dashboard
Documentation=man:einheit-f-ui(8)
After=fd.service network.target
Wants=fd.service

[Service]
Type=simple
ExecStart=/usr/local/bin/einheit-f-ui \
    --bind 0.0.0.0 \
    --port 443 \
    --socket ipc:///run/f/control.sock \
    --templates /usr/share/einheit-ui/templates \
    --assets /usr/share/einheit-ui/assets
Restart=on-failure
RestartSec=3s

User=www-data
Group=www-data

# There is deliberately no `SupplementaryGroups=f`. There was, and
# nothing on any box has ever created a group called `f`, so systemd
# failed at step GROUP with status 216 before exec — on every start,
# forever, at RestartSec=3s. `systemctl is-active` says "activating"
# rather than "failed" while a unit is in auto-restart, which is how a
# dashboard that had never once served a page read as coming up.
#
# It would also have granted nothing. The data this process shows
# arrives over /run/f/control.sock, and fd's pins under /sys/fs/bpf/f
# are 0700 root with no group ownership for anything to inherit. If
# the pins are ever given a group, the group and this line get added
# in the same change.

# Hardening.
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/sys/fs/bpf/f
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

# Allow binding to port 443.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

StandardOutput=journal
StandardError=journal
SyslogIdentifier=einheit-f-ui

[Install]
WantedBy=multi-user.target
