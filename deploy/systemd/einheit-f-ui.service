[Unit]
Description=f firewall web dashboard
Documentation=man:einheit-f-ui(8)
After=fd.service network.target
Wants=fd.service

[Service]
Type=simple
ExecStart=/usr/local/bin/einheit-f-ui \
    --bind 0.0.0.0 \
    --port 443 \
    --pin-path /sys/fs/bpf/f \
    --socket ipc:///run/f/control.sock \
    --templates /usr/share/einheit-ui/templates \
    --assets /usr/share/einheit-ui/assets
Restart=on-failure
RestartSec=3s

User=www-data
Group=www-data
SupplementaryGroups=f

# Hardening.
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/sys/fs/bpf/f
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

# Allow binding to port 443.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

StandardOutput=journal
StandardError=journal
SyslogIdentifier=einheit-f-ui

[Install]
WantedBy=multi-user.target
