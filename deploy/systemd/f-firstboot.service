[Unit]
Description=f appliance first-boot provisioning
Documentation=file:///usr/share/f/f-provision.yaml.example

# The marker is written by the provisioner and only after a run that
# finished. A run that stopped at a failure leaves it absent, so the
# next boot tries again rather than skipping past a box that was never
# provisioned.
ConditionPathExists=!/etc/f/.provisioned

After=local-fs.target systemd-networkd.service

# THERE IS DELIBERATELY NO `Before=fd.service ...` HERE, and removing
# it is the fix for a deadlock that hangs a first boot forever.
#
# It used to read `Before=fd.service f-confd.service
# einheit-f-ui.service` and `Before=f-dnsmasq.service
# f-chrony.service`, on the reasoning that fd cold-boots into whatever
# `current` points at and must not start before a bundle exists. But
# firstboot.py is what enables and starts those units, from inside
# this unit's own ExecStart, and it waits for each one — so systemd
# was asked to run a job it had been ordered to run only after the job
# that was waiting for it. Measured on the first image that got far
# enough to reach the step:
#
#   JOB UNIT                TYPE  STATE
#   108 f-firstboot.service start running
#   137 fd.service          start waiting
#
# and `TimeoutStartUSec=infinity`, because that is systemd's default
# for Type=oneshot. Nothing breaks the cycle: multi-user.target is
# never reached, the marker is never written, and the box sits there.
#
# The ordering is not needed to get what it was protecting. Nothing
# enables fd, f-confd, einheit-f-ui, f-dnsmasq or f-chrony in the
# image — `build_image.py` enables systemd-networkd, this unit and
# ssh, and no others — so on a first boot the only thing that can
# start them is firstboot.py, which does it after it has written
# everything they read. And on every boot after the first, the marker
# exists and this unit is skipped by its own condition.
#
# `deploy/tests/test_firstboot_unit.py` fails if a Before= naming any
# of them comes back.

[Service]
Type=oneshot
ExecStart=/usr/local/share/f/firstboot.py
RemainAfterExit=yes

# A failed provisioning run is a box that is reachable and not
# filtering, and it says so on the console. It must not be retried in
# a loop: the operator has to see the message and act on it.
Restart=no

StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
