[Unit]
Description=f — eBPF firewall engine
Documentation=https://github.com/einheitdev/f
After=network-pre.target sys-fs-bpf.mount systemd-networkd.service
Before=network.target
Wants=sys-fs-bpf.mount network-pre.target
ConditionPathIsMountPoint=/sys/fs/bpf

# The restart loop has to terminate, and here is why it is not just
# tidiness. This unit is ordered Before=network.target, i.e. before
# sshd, and Restart=on-failure. A bundle that cannot be loaded therefore
# blocks the box's own management access for as long as fd keeps trying
# — and `Restart=` on its own tries forever. With these two, three
# failed starts inside five minutes put the unit in `failed`, systemd
# releases network.target, and the box comes up reachable and (because
# fd lowers ip_forward on its way out, and ExecStopPost does it again)
# not routing.
#
# The other half of the same guarantee is in fd itself: see
# bundle_guard.h. This bounds the case where fd EXITS; the guard bounds
# the case where fd never gets to exit because the load took the board
# down, which is the one that cost three power cycles on 2026-08-23 and
# which no systemd setting can see.
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
# Readiness is signalled by fd itself once XDP is attached, so
# systemd holds network.target until the datapath is actually armed
# rather than merely until the process has been exec'd.
Type=notify
NotifyAccess=main
ExecStart=/usr/local/bin/fd -c /etc/f/fd.yaml run

# Fail closed on the path fd cannot cover from inside itself.
#
# fd lowers net.ipv4.ip_forward on its way in and on its way out, so a
# clean stop, a refused bundle and a failed attach all leave the box
# non-routing without help. SIGKILL, a segfault and an OOM kill do not
# — EngineStop never runs, the XDP programs stay attached, and the
# knob stays at 1 with no daemon behind it. systemd runs ExecStopPost
# after the main process dies however it died, including after an
# ExecStart that never started, which is exactly the gap.
#
# Written with the same binary rather than `sh -c 'echo 0 > ...'` so
# the reason is journalled under this unit's own identity, and so
# there is one place that knows the path.
ExecStopPost=-/usr/local/bin/fd close-forwarding

CapabilityBoundingSet=CAP_BPF CAP_NET_ADMIN CAP_PERFMON CAP_SYS_RESOURCE
AmbientCapabilities=CAP_BPF CAP_NET_ADMIN CAP_PERFMON CAP_SYS_RESOURCE

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=false
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

ReadWritePaths=/sys/fs/bpf /usr/share/f/compiled /var/log/f

# /run/f is shared: fd puts control.sock there and f-confd puts
# confd.sock there. systemd deletes a RuntimeDirectory when the unit
# that declares it stops, so without Preserve a restart of fd removes
# the whole directory and takes f-confd's live socket with it — and
# f-confd, still running and still bound to the unlinked inode, never
# notices. The visible symptom is that `apply system confirmed` starts
# refusing with "f-confd is not running" on a box where it is, i.e.
# the anti-lockout rollback is silently disarmed by the very restart
# the handbook prescribes as a recovery step.
RuntimeDirectory=f
RuntimeDirectoryPreserve=yes

LimitMEMLOCK=infinity
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s

# A start that hangs must fail rather than hold the boot open. Type=notify
# means systemd waits for fd to report the datapath armed, and everything
# ordered after network.target — sshd included — waits with it. Without a
# bound, a bundle whose verifier pass never finishes is an unbootable box
# rather than a slow one.
#
# 90s is chosen against measurement, not taste: on the reference rig a
# 2,500-rule policy verified in 3.0s and a 10,000-rule one never
# completed at all. Anything in between is a policy that has left the
# range this box can run, and the answer is to say so and let the
# operator in, not to keep waiting.
TimeoutStartSec=90

StandardOutput=journal
StandardError=journal
SyslogIdentifier=fd

[Install]
WantedBy=multi-user.target
