[Unit]
Description=f — eBPF firewall engine
Documentation=https://github.com/einheitdev/f
After=network-pre.target sys-fs-bpf.mount systemd-networkd.service
Before=network.target
Wants=sys-fs-bpf.mount network-pre.target
ConditionPathIsMountPoint=/sys/fs/bpf

[Service]
# Readiness is signalled by fd itself once XDP is attached, so
# systemd holds network.target until the datapath is actually armed
# rather than merely until the process has been exec'd.
Type=notify
NotifyAccess=main
ExecStart=/usr/local/bin/fd -c /etc/f/fd.yaml run

CapabilityBoundingSet=CAP_BPF CAP_NET_ADMIN CAP_PERFMON CAP_SYS_RESOURCE
AmbientCapabilities=CAP_BPF CAP_NET_ADMIN CAP_PERFMON CAP_SYS_RESOURCE

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=false
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

ReadWritePaths=/sys/fs/bpf /usr/share/f/compiled /var/log/f
RuntimeDirectory=f

LimitMEMLOCK=infinity
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=fd

[Install]
WantedBy=multi-user.target
