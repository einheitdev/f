// FWL v0.1 grammar for Lark.
//
// Transcribed from the EBNF reference in docs/FWL_V01_SPEC.md.
// Anything not listed here is a syntax error.
//
// Phase 1 surface: hook + rules of the form `<action> [if <comparison>]`
// where the only field is pkt.proto and the only operand is a proto
// keyword. Multi-rule sequencing and default land in Phase 2.

program       : hook_decl rule*

hook_decl     : "@xdp" "(" IDENTIFIER ")"

rule          : action ("if" condition)?

action        : ALLOW | DROP

condition     : comparison

comparison    : field "==" operand

field         : PROTO_FIELD

operand       : PROTO_KEYWORD

PROTO_FIELD   : "pkt.proto"
PROTO_KEYWORD : "tcp" | "udp" | "icmp"
ALLOW         : "allow"
DROP          : "drop"

IDENTIFIER    : /[a-z_][a-z0-9_]*/

COMMENT       : /#[^\n]*/

%import common.WS
%ignore WS
%ignore COMMENT
