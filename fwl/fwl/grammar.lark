// FWL v0.1 grammar for Lark.
//
// Transcribed from the EBNF reference in docs/FWL_V01_SPEC.md.
// Anything not listed here is a syntax error.
//
// Phase 2 surface: hook + zero-or-more rules + optional default rule.
// Programs may consist solely of `@xdp(...) default <action>` per
// the spec note at FWL_V01_SPEC.md:602.

program       : hook_decl rule* default_rule?

hook_decl     : "@xdp" "(" IDENTIFIER ")"

rule          : action ("if" condition)?

default_rule  : "default" terminal_action

action        : terminal_action

terminal_action : ALLOW | DROP

condition     : comparison

comparison    : field "==" operand

field         : PROTO_FIELD

operand       : PROTO_KEYWORD

PROTO_FIELD   : "pkt.proto"
PROTO_KEYWORD : "tcp" | "udp" | "icmp"
ALLOW         : "allow"
DROP          : "drop"

IDENTIFIER    : /[a-z_][a-z0-9_]*/

COMMENT       : /#[^\n]*/

%import common.WS
%ignore WS
%ignore COMMENT
