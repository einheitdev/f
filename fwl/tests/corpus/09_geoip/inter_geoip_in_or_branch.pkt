name: "geoip on RHS of one or-branch combines with non-geoip on the other"
source_fw: |
  @xdp(eth0)
  drop if pkt.src_ip in 10.0.0.0/8 or pkt.src_ip in geoip(RU)
  default allow

geoip_data:
  RU: ["5.8.0.0/16"]

test_packet:
  builder: tcp(src_ip="5.8.1.1", dst_port=80)

expected:
  compiles: true
  bpf_action: drop
