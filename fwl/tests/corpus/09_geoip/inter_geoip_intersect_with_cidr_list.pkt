name: "geoip and cidr-list intersection: source must be in BOTH"
source_fw: |
  @xdp(eth0)
  drop if pkt.src_ip in [10.0.0.0/8] and pkt.src_ip in geoip(US)
  default allow

geoip_data:
  US: ["10.0.0.0/8"]

test_packet:
  builder: tcp(src_ip="10.0.0.1", dst_port=22)

expected:
  compiles: true
  bpf_action: drop
