name: "geoip + count: count action is non-terminal; falls through to default"
source_fw: |
  @xdp(eth0)
  count blocked_country if pkt.src_ip in geoip(RU)
  default allow

geoip_data:
  RU: ["5.8.0.0/16"]

test_packet:
  builder: tcp(src_ip="5.8.1.1", dst_port=80)

expected:
  compiles: true
  bpf_action: allow
