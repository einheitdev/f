name: "Tier 2: if/elif/else chain — TCP 80 → allow"
source_fw: |
  @xdp(eth0)
  def firewall(pkt):
    if pkt.proto == tcp:
      if pkt.dst_port == 22:
        drop
      elif pkt.dst_port in [80, 443]:
        allow
      else:
        drop
    elif pkt.proto == udp:
      allow
    else:
      drop

test_packet:
  builder: tcp(dst_port=80)

expected:
  compiles: true
  bpf_action: allow
