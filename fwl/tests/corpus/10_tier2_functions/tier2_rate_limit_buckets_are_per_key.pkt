name: "Tier 2 rate_limit(): each src_ip carries its own bucket"
source_fw: |
  @xdp(eth0)

  def firewall(pkt):
    if pkt.proto == tcp and pkt.src_ip in 0.0.0.0/0:
      if rate_limit(3, per=src_ip):
        drop
    allow

state:
  rate_limit:
    0:
      "1.2.3.4": 100

test_packet:
  builder: tcp(src_ip="5.6.7.8", dst_port=22)

expected:
  compiles: true
  # 5.6.7.8 has its own bucket at 0, however saturated 1.2.3.4's is.
  bpf_action: allow
