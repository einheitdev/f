name: "count and log together"
source_fw: |
  @xdp(eth0)
  count ssh if pkt.proto == tcp and pkt.dst_port == 22
  log if pkt.proto == tcp and pkt.dst_port == 22
  drop if pkt.proto == tcp and pkt.dst_port == 22
  default allow

test_packet:
  builder: tcp(dst_port=22)

expected:
  compiles: true
  bpf_action: drop
  counter_changes:
    ssh: 1
