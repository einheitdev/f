name: "counter with rate_limit"
source_fw: |
  @xdp(eth0)
  count rl_drops if pkt.proto == tcp limited by rate_limit(5, per=src_ip)
  default allow

test_packet:
  builder: tcp(src_ip="1.2.3.4")
state:
  rate_limit:
    0:
      "1.2.3.4": 5

expected:
  compiles: true
  bpf_action: allow
  counter_changes:
    rl_drops: 1
