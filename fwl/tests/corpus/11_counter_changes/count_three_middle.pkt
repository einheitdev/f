name: "three counters middle fires"
source_fw: |
  @xdp(eth0)
  count tcp_t if pkt.proto == tcp
  count udp_t if pkt.proto == udp
  count icmp_t if pkt.proto == icmp
  allow

test_packet:
  builder: udp()

expected:
  compiles: true
  bpf_action: allow
  counter_changes:
    tcp_t: 0
    udp_t: 1
    icmp_t: 0
