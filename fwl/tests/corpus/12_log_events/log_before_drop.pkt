name: "log before drop"
source_fw: |
  @xdp(eth0)
  log if pkt.proto == tcp and pkt.dst_port == 22
  drop if pkt.proto == tcp and pkt.dst_port == 22
  default allow

test_packet:
  builder: tcp(src_ip="10.0.0.1", dst_port=22)

expected:
  compiles: true
  bpf_action: drop
  log_events:
    - rule_index: 0
      proto: tcp
      dst_port: 22
