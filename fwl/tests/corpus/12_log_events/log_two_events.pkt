name: "two log events"
source_fw: |
  @xdp(eth0)
  log if pkt.proto == tcp
  log if pkt.proto == tcp and pkt.dst_port == 80
  allow

test_packet:
  builder: tcp(src_ip="1.1.1.1", dst_port=80)

expected:
  compiles: true
  bpf_action: allow
  log_events:
    - rule_index: 0
      proto: tcp
    - rule_index: 1
      dst_port: 80
