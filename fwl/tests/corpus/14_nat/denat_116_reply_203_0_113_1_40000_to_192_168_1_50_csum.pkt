name: "denat 116 reply 203.0.113.1 40000 to 192.168.1.50 csum"
source_fw: |
  @xdp(wan)
  snat to 203.0.113.1 if pkt.proto == udp
  allow
state:
  nat:
    mappings:
      - { proto: tcp, src_ip: "208.67.222.222", dst_ip: "203.0.113.1", src_port: 80, dst_port: 40000, new_ip: "192.168.1.50", new_port: 40000, nat_type: dnat }
test_packet:
  builder: tcp(src_ip="208.67.222.222", dst_ip="203.0.113.1", src_port=80, dst_port=40000, ack=true)
expected:
  compiles: true
  bpf_action: allow
  output_packet:
    src_ip: "208.67.222.222"
    dst_ip: "192.168.1.50"
    dst_port: 40000
