name: "denat 133 reply 203.0.113.250 443 to 192.168.1.50 csum"
source_fw: |
  @xdp(wan)
  snat to 203.0.113.250 if pkt.proto == udp
  allow
state:
  nat:
    mappings:
      - { proto: tcp, src_ip: "1.1.1.1", dst_ip: "203.0.113.250", src_port: 80, dst_port: 443, new_ip: "192.168.1.50", new_port: 443, nat_type: dnat }
test_packet:
  builder: tcp(src_ip="1.1.1.1", dst_ip="203.0.113.250", src_port=80, dst_port=443, ack=true)
expected:
  compiles: true
  bpf_action: allow
  output_packet:
    src_ip: "1.1.1.1"
    dst_ip: "192.168.1.50"
    dst_port: 443
