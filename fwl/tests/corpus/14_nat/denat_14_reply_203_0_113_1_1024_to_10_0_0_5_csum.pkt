name: "denat 14 reply 203.0.113.1 1024 to 10.0.0.5 csum"
source_fw: |
  @xdp(wan)
  snat to 203.0.113.1 if pkt.proto == udp
  allow
state:
  nat:
    mappings:
      - { proto: tcp, src_ip: "140.82.112.3", dst_ip: "203.0.113.1", src_port: 80, dst_port: 1024, new_ip: "10.0.0.5", new_port: 1024, nat_type: dnat }
test_packet:
  builder: tcp(src_ip="140.82.112.3", dst_ip="203.0.113.1", src_port=80, dst_port=1024, ack=true)
expected:
  compiles: true
  bpf_action: allow
  output_packet:
    src_ip: "140.82.112.3"
    dst_ip: "10.0.0.5"
    dst_port: 1024
