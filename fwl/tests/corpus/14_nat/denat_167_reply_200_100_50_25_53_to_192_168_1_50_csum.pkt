name: "denat 167 reply 200.100.50.25 53 to 192.168.1.50 csum"
source_fw: |
  @xdp(wan)
  snat to 200.100.50.25 if pkt.proto == udp
  allow
state:
  nat:
    mappings:
      - { proto: tcp, src_ip: "9.9.9.9", dst_ip: "200.100.50.25", src_port: 80, dst_port: 53, new_ip: "192.168.1.50", new_port: 53, nat_type: dnat }
test_packet:
  builder: tcp(src_ip="9.9.9.9", dst_ip="200.100.50.25", src_port=80, dst_port=53, ack=true)
expected:
  compiles: true
  bpf_action: allow
  output_packet:
    src_ip: "9.9.9.9"
    dst_ip: "192.168.1.50"
    dst_port: 53
