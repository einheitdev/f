name: "denat 184 reply 203.0.113.99 1024 to 192.168.1.50 csum"
source_fw: |
  @xdp(wan)
  snat to 203.0.113.99 if pkt.proto == udp
  allow
state:
  nat:
    mappings:
      - { proto: tcp, src_ip: "140.82.112.3", dst_ip: "203.0.113.99", src_port: 80, dst_port: 1024, new_ip: "192.168.1.50", new_port: 1024, nat_type: dnat }
test_packet:
  builder: tcp(src_ip="140.82.112.3", dst_ip="203.0.113.99", src_port=80, dst_port=1024, ack=true)
expected:
  compiles: true
  bpf_action: allow
  output_packet:
    src_ip: "140.82.112.3"
    dst_ip: "192.168.1.50"
    dst_port: 1024
