name: "denat 29 reply 198.51.100.255 8080 to 10.0.0.5 csum"
source_fw: |
  @xdp(wan)
  snat to 198.51.100.255 if pkt.proto == udp
  allow
state:
  nat:
    mappings:
      - { proto: tcp, src_ip: "13.107.21.200", dst_ip: "198.51.100.255", src_port: 80, dst_port: 8080, new_ip: "10.0.0.5", new_port: 8080, nat_type: dnat }
test_packet:
  builder: tcp(src_ip="13.107.21.200", dst_ip="198.51.100.255", src_port=80, dst_port=8080, ack=true)
expected:
  compiles: true
  bpf_action: allow
  output_packet:
    src_ip: "13.107.21.200"
    dst_ip: "10.0.0.5"
    dst_port: 8080
