name: "denat 48 reply 1.2.3.4 65535 to 10.0.0.5 csum"
source_fw: |
  @xdp(wan)
  snat to 1.2.3.4 if pkt.proto == udp
  allow
state:
  nat:
    mappings:
      - { proto: tcp, src_ip: "104.16.0.1", dst_ip: "1.2.3.4", src_port: 80, dst_port: 65535, new_ip: "10.0.0.5", new_port: 65535, nat_type: dnat }
test_packet:
  builder: tcp(src_ip="104.16.0.1", dst_ip="1.2.3.4", src_port=80, dst_port=65535, ack=true)
expected:
  compiles: true
  bpf_action: allow
  output_packet:
    src_ip: "104.16.0.1"
    dst_ip: "10.0.0.5"
    dst_port: 65535
