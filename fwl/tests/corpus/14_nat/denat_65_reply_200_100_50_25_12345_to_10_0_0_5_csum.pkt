name: "denat 65 reply 200.100.50.25 12345 to 10.0.0.5 csum"
source_fw: |
  @xdp(wan)
  snat to 200.100.50.25 if pkt.proto == udp
  allow
state:
  nat:
    mappings:
      - { proto: tcp, src_ip: "151.101.0.1", dst_ip: "200.100.50.25", src_port: 80, dst_port: 12345, new_ip: "10.0.0.5", new_port: 12345, nat_type: dnat }
test_packet:
  builder: tcp(src_ip="151.101.0.1", dst_ip="200.100.50.25", src_port=80, dst_port=12345, ack=true)
expected:
  compiles: true
  bpf_action: allow
  output_packet:
    src_ip: "151.101.0.1"
    dst_ip: "10.0.0.5"
    dst_port: 12345
