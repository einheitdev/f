name: "denat 73 reply 198.51.100.128 443 to 10.0.0.5 csum"
source_fw: |
  @xdp(wan)
  snat to 198.51.100.128 if pkt.proto == udp
  allow
state:
  nat:
    mappings:
      - { proto: tcp, src_ip: "1.1.1.1", dst_ip: "198.51.100.128", src_port: 80, dst_port: 443, new_ip: "10.0.0.5", new_port: 443, nat_type: dnat }
test_packet:
  builder: tcp(src_ip="1.1.1.1", dst_ip="198.51.100.128", src_port=80, dst_port=443, ack=true)
expected:
  compiles: true
  bpf_action: allow
  output_packet:
    src_ip: "1.1.1.1"
    dst_ip: "10.0.0.5"
    dst_port: 443
