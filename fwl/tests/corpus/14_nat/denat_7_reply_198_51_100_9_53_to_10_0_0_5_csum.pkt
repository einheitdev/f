name: "denat 7 reply 198.51.100.9 53 to 10.0.0.5 csum"
source_fw: |
  @xdp(wan)
  snat to 198.51.100.9 if pkt.proto == udp
  allow
state:
  nat:
    mappings:
      - { proto: tcp, src_ip: "9.9.9.9", dst_ip: "198.51.100.9", src_port: 80, dst_port: 53, new_ip: "10.0.0.5", new_port: 53, nat_type: dnat }
test_packet:
  builder: tcp(src_ip="9.9.9.9", dst_ip="198.51.100.9", src_port=80, dst_port=53, ack=true)
expected:
  compiles: true
  bpf_action: allow
  output_packet:
    src_ip: "9.9.9.9"
    dst_ip: "10.0.0.5"
    dst_port: 53
