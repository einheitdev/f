name: "denat 82 reply 203.0.113.99 80 to 10.0.0.5 csum"
source_fw: |
  @xdp(wan)
  snat to 203.0.113.99 if pkt.proto == udp
  allow
state:
  nat:
    mappings:
      - { proto: tcp, src_ip: "8.8.8.8", dst_ip: "203.0.113.99", src_port: 80, dst_port: 80, new_ip: "10.0.0.5", new_port: 80, nat_type: dnat }
test_packet:
  builder: tcp(src_ip="8.8.8.8", dst_ip="203.0.113.99", src_port=80, dst_port=80, ack=true)
expected:
  compiles: true
  bpf_action: allow
  output_packet:
    src_ip: "8.8.8.8"
    dst_ip: "10.0.0.5"
    dst_port: 80
