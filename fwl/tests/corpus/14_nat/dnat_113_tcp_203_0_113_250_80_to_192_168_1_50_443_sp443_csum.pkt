name: "dnat 113 tcp 203.0.113.250 80 to 192.168.1.50 443 sp443 csum"
source_fw: |
  @xdp(wan)
  dnat to 192.168.1.50:443 if pkt.proto == tcp and pkt.dst_port == 80
  allow
test_packet:
  builder: tcp(src_ip="8.8.8.8", dst_ip="203.0.113.250", src_port=443, dst_port=80, syn=true)
expected:
  compiles: true
  bpf_action: allow
  output_packet:
    src_ip: "8.8.8.8"
    dst_ip: "192.168.1.50"
    dst_port: 443
