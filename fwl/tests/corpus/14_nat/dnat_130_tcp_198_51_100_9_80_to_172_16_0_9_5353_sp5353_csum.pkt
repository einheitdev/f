name: "dnat 130 tcp 198.51.100.9 80 to 172.16.0.9 5353 sp5353 csum"
source_fw: |
  @xdp(wan)
  dnat to 172.16.0.9:5353 if pkt.proto == tcp and pkt.dst_port == 80
  allow
test_packet:
  builder: tcp(src_ip="8.8.8.8", dst_ip="198.51.100.9", src_port=5353, dst_port=80, syn=true)
expected:
  compiles: true
  bpf_action: allow
  output_packet:
    src_ip: "8.8.8.8"
    dst_ip: "172.16.0.9"
    dst_port: 5353
