name: "dnat 147 tcp 198.51.100.128 80 to 10.255.0.1 53 sp53 csum"
source_fw: |
  @xdp(wan)
  dnat to 10.255.0.1:53 if pkt.proto == tcp and pkt.dst_port == 80
  allow
test_packet:
  builder: tcp(src_ip="8.8.8.8", dst_ip="198.51.100.128", src_port=53, dst_port=80, syn=true)
expected:
  compiles: true
  bpf_action: allow
  output_packet:
    src_ip: "8.8.8.8"
    dst_ip: "10.255.0.1"
    dst_port: 53
