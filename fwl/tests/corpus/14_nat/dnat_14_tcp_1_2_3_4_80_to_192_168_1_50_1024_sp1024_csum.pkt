name: "dnat 14 tcp 1.2.3.4 80 to 192.168.1.50 1024 sp1024 csum"
source_fw: |
  @xdp(wan)
  dnat to 192.168.1.50:1024 if pkt.proto == tcp and pkt.dst_port == 80
  allow
test_packet:
  builder: tcp(src_ip="93.184.216.34", dst_ip="1.2.3.4", src_port=1024, dst_port=80, syn=true)
expected:
  compiles: true
  bpf_action: allow
  output_packet:
    src_ip: "93.184.216.34"
    dst_ip: "192.168.1.50"
    dst_port: 1024
