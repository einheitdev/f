name: "dnat 202 tcp 198.51.100.255 80 to 10.0.0.5 80 sp80 csum"
source_fw: |
  @xdp(wan)
  dnat to 10.0.0.5:80 if pkt.proto == tcp and pkt.dst_port == 80
  allow
test_packet:
  builder: tcp(src_ip="1.1.1.1", dst_ip="198.51.100.255", src_port=80, dst_port=80, syn=true)
expected:
  compiles: true
  bpf_action: allow
  output_packet:
    src_ip: "1.1.1.1"
    dst_ip: "10.0.0.5"
    dst_port: 80
