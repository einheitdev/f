name: "dnat 79 tcp 11.22.33.44 80 to 10.0.0.255 8080 sp8080 csum"
source_fw: |
  @xdp(wan)
  dnat to 10.0.0.255:8080 if pkt.proto == tcp and pkt.dst_port == 80
  allow
test_packet:
  builder: tcp(src_ip="93.184.216.34", dst_ip="11.22.33.44", src_port=8080, dst_port=80, syn=true)
expected:
  compiles: true
  bpf_action: allow
  output_packet:
    src_ip: "93.184.216.34"
    dst_ip: "10.0.0.255"
    dst_port: 8080
