name: "dnat 80 tcp 198.51.100.9 80 to 10.0.0.255 5353 sp5353 csum"
source_fw: |
  @xdp(wan)
  dnat to 10.0.0.255:5353 if pkt.proto == tcp and pkt.dst_port == 80
  allow
test_packet:
  builder: tcp(src_ip="93.184.216.34", dst_ip="198.51.100.9", src_port=5353, dst_port=80, syn=true)
expected:
  compiles: true
  bpf_action: allow
  output_packet:
    src_ip: "93.184.216.34"
    dst_ip: "10.0.0.255"
    dst_port: 5353
