name: "masq 106 udp 192.168.250.250 via 198.51.100.255 sp53 csum"
source_fw: |
  @xdp(lan)
  masquerade if pkt.proto == udp
  allow
state:
  nat:
    masq_ip: "198.51.100.255"
test_packet:
  builder: udp(src_ip="192.168.250.250", dst_ip="208.67.222.222", src_port=53, dst_port=1)
expected:
  compiles: true
  bpf_action: allow
  output_packet:
    src_ip: "198.51.100.255"
    dst_ip: "208.67.222.222"
    src_port: 53
