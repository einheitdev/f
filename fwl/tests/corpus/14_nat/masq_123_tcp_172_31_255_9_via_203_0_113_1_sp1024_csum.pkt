name: "masq 123 tcp 172.31.255.9 via 203.0.113.1 sp1024 csum"
source_fw: |
  @xdp(lan)
  masquerade if pkt.proto == tcp
  allow
state:
  nat:
    masq_ip: "203.0.113.1"
test_packet:
  builder: tcp(src_ip="172.31.255.9", dst_ip="1.1.1.1", src_port=1024, dst_port=65535, syn=true)
expected:
  compiles: true
  bpf_action: allow
  output_packet:
    src_ip: "203.0.113.1"
    dst_ip: "1.1.1.1"
    src_port: 1024
