name: "masq 21 tcp 192.168.1.50 via 198.51.100.9 sp80 csum"
source_fw: |
  @xdp(lan)
  masquerade if pkt.proto == tcp
  allow
state:
  nat:
    masq_ip: "198.51.100.9"
test_packet:
  builder: tcp(src_ip="192.168.1.50", dst_ip="93.184.216.34", src_port=80, dst_port=40000, syn=true)
expected:
  compiles: true
  bpf_action: allow
  output_packet:
    src_ip: "198.51.100.9"
    dst_ip: "93.184.216.34"
    src_port: 80
