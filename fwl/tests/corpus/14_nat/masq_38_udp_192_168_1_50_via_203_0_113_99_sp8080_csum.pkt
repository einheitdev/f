name: "masq 38 udp 192.168.1.50 via 203.0.113.99 sp8080 csum"
source_fw: |
  @xdp(lan)
  masquerade if pkt.proto == udp
  allow
state:
  nat:
    masq_ip: "203.0.113.99"
test_packet:
  builder: udp(src_ip="192.168.1.50", dst_ip="104.16.0.1", src_port=8080, dst_port=443)
expected:
  compiles: true
  bpf_action: allow
  output_packet:
    src_ip: "203.0.113.99"
    dst_ip: "104.16.0.1"
    src_port: 8080
