name: "masq 72 udp 10.1.2.3 via 255.1.255.1 sp443 csum"
source_fw: |
  @xdp(lan)
  masquerade if pkt.proto == udp
  allow
state:
  nat:
    masq_ip: "255.1.255.1"
test_packet:
  builder: udp(src_ip="10.1.2.3", dst_ip="8.8.8.8", src_port=443, dst_port=53)
expected:
  compiles: true
  bpf_action: allow
  output_packet:
    src_ip: "255.1.255.1"
    dst_ip: "8.8.8.8"
    src_port: 443
