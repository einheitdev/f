name: "vlan 100 snat 7 10.0.0.5 to 203.0.113.1 sp8080 csum"
source_fw: |
  @xdp(lan)
  snat to 203.0.113.1 if pkt.proto == tcp
  allow
test_packet:
  builder: tcp(src_ip="10.0.0.5", dst_ip="9.9.9.9", src_port=8080, dst_port=1024, syn=true, vlan_id=100)
expected:
  compiles: true
  bpf_action: allow
  output_packet:
    src_ip: "203.0.113.1"
    dst_ip: "9.9.9.9"
    src_port: 8080
