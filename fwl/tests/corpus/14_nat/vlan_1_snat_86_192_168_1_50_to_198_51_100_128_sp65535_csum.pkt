name: "vlan 1 snat 86 192.168.1.50 to 198.51.100.128 sp65535 csum"
source_fw: |
  @xdp(lan)
  snat to 198.51.100.128 if pkt.proto == tcp
  allow
test_packet:
  builder: tcp(src_ip="192.168.1.50", dst_ip="208.67.222.222", src_port=65535, dst_port=443, syn=true, vlan_id=1)
expected:
  compiles: true
  bpf_action: allow
  output_packet:
    src_ip: "198.51.100.128"
    dst_ip: "208.67.222.222"
    src_port: 65535
