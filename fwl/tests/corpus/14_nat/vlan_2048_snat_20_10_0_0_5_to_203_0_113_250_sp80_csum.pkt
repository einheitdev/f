name: "vlan 2048 snat 20 10.0.0.5 to 203.0.113.250 sp80 csum"
source_fw: |
  @xdp(lan)
  snat to 203.0.113.250 if pkt.proto == tcp
  allow
test_packet:
  builder: tcp(src_ip="10.0.0.5", dst_ip="185.199.108.1", src_port=80, dst_port=53, syn=true, vlan_id=2048)
expected:
  compiles: true
  bpf_action: allow
  output_packet:
    src_ip: "203.0.113.250"
    dst_ip: "185.199.108.1"
    src_port: 80
