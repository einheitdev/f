name: "vlan 4094 snat 143 172.16.0.9 to 203.0.113.99 sp12345 csum"
source_fw: |
  @xdp(lan)
  snat to 203.0.113.99 if pkt.proto == tcp
  allow
test_packet:
  builder: tcp(src_ip="172.16.0.9", dst_ip="1.1.1.1", src_port=12345, dst_port=5353, syn=true, vlan_id=4094)
expected:
  compiles: true
  bpf_action: allow
  output_packet:
    src_ip: "203.0.113.99"
    dst_ip: "1.1.1.1"
    src_port: 12345
