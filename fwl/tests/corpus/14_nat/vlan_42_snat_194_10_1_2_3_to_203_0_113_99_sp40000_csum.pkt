name: "vlan 42 snat 194 10.1.2.3 to 203.0.113.99 sp40000 csum"
source_fw: |
  @xdp(lan)
  snat to 203.0.113.99 if pkt.proto == tcp
  allow
test_packet:
  builder: tcp(src_ip="10.1.2.3", dst_ip="140.82.112.3", src_port=40000, dst_port=1, syn=true, vlan_id=42)
expected:
  compiles: true
  bpf_action: allow
  output_packet:
    src_ip: "203.0.113.99"
    dst_ip: "140.82.112.3"
    src_port: 40000
