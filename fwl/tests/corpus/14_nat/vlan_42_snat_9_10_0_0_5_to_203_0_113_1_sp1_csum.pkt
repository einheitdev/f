name: "vlan 42 snat 9 10.0.0.5 to 203.0.113.1 sp1 csum"
source_fw: |
  @xdp(lan)
  snat to 203.0.113.1 if pkt.proto == tcp
  allow
test_packet:
  builder: tcp(src_ip="10.0.0.5", dst_ip="13.107.21.200", src_port=1, dst_port=40000, syn=true, vlan_id=42)
expected:
  compiles: true
  bpf_action: allow
  output_packet:
    src_ip: "203.0.113.1"
    dst_ip: "13.107.21.200"
    src_port: 1
