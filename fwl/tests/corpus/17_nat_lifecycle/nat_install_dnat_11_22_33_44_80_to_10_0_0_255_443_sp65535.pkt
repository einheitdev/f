name: "nat install dnat 11.22.33.44 80 to 10.0.0.255 443 sp65535"
source_fw: |
  @xdp(wan)
  dnat to 10.0.0.255:443 if pkt.proto == tcp and pkt.dst_port == 80
  allow
sequence:
  - name: inbound — DNAT and install the reply mapping
    builder: tcp(src_ip="8.8.8.8", dst_ip="11.22.33.44", src_port=65535, dst_port=80, syn=true)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "8.8.8.8"
        dst_ip: "10.0.0.255"
        dst_port: 443
  - name: reply — source rewritten back to the public endpoint
    builder: tcp(src_ip="10.0.0.255", dst_ip="8.8.8.8", src_port=443, dst_port=65535, ack=true)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "11.22.33.44"
        dst_ip: "8.8.8.8"
        src_port: 80
