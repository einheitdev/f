name: "nat install dnat 200.100.50.25 80 to 10.0.0.5 5353 sp1024"
source_fw: |
  @xdp(wan)
  dnat to 10.0.0.5:5353 if pkt.proto == tcp and pkt.dst_port == 80
  allow
sequence:
  - name: inbound — DNAT and install the reply mapping
    builder: tcp(src_ip="93.184.216.34", dst_ip="200.100.50.25", src_port=1024, dst_port=80, syn=true)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "93.184.216.34"
        dst_ip: "10.0.0.5"
        dst_port: 5353
  - name: reply — source rewritten back to the public endpoint
    builder: tcp(src_ip="10.0.0.5", dst_ip="93.184.216.34", src_port=5353, dst_port=1024, ack=true)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "200.100.50.25"
        dst_ip: "93.184.216.34"
        src_port: 80
