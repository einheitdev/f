name: "nat install dnat 203.0.113.250 80 to 10.0.0.5 22 sp51000"
source_fw: |
  @xdp(wan)
  dnat to 10.0.0.5:22 if pkt.proto == tcp and pkt.dst_port == 80
  allow
sequence:
  - name: inbound — DNAT and install the reply mapping
    builder: tcp(src_ip="208.67.222.222", dst_ip="203.0.113.250", src_port=51000, dst_port=80, syn=true)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "208.67.222.222"
        dst_ip: "10.0.0.5"
        dst_port: 22
  - name: reply — source rewritten back to the public endpoint
    builder: tcp(src_ip="10.0.0.5", dst_ip="208.67.222.222", src_port=22, dst_port=51000, ack=true)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "203.0.113.250"
        dst_ip: "208.67.222.222"
        src_port: 80
