name: "nat install masq 10.1.2.3 via 203.0.113.1 to 1.1.1.1 80"
source_fw: |
  @xdp(wan)
  masquerade if pkt.proto == tcp and pkt.src_ip in [10.0.0.0/8]
  allow
state:
  nat:
    masq_ip: "203.0.113.1"
sequence:
  - name: outbound — masquerade and install the reply mapping
    builder: tcp(src_ip="10.1.2.3", dst_ip="1.1.1.1", src_port=33333, dst_port=80, syn=true)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "203.0.113.1"
        dst_ip: "1.1.1.1"
        src_port: 33333
  - name: reply — de-NAT via the mapping step 1 installed
    builder: tcp(src_ip="1.1.1.1", dst_ip="203.0.113.1", src_port=80, dst_port=33333, ack=true)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "1.1.1.1"
        dst_ip: "10.1.2.3"
        dst_port: 33333
