name: "nat install masq 10.255.0.1 via 198.51.100.9 to 8.8.8.8 443"
source_fw: |
  @xdp(wan)
  masquerade if pkt.proto == tcp and pkt.src_ip in [10.0.0.0/8]
  allow
state:
  nat:
    masq_ip: "198.51.100.9"
sequence:
  - name: outbound — masquerade and install the reply mapping
    builder: tcp(src_ip="10.255.0.1", dst_ip="8.8.8.8", src_port=65535, dst_port=443, syn=true)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "198.51.100.9"
        dst_ip: "8.8.8.8"
        src_port: 65535
  - name: reply — de-NAT via the mapping step 1 installed
    builder: tcp(src_ip="8.8.8.8", dst_ip="198.51.100.9", src_port=443, dst_port=65535, ack=true)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "8.8.8.8"
        dst_ip: "10.255.0.1"
        dst_port: 65535
