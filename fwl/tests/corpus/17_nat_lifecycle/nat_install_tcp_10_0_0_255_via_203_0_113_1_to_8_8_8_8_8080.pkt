name: "nat install tcp 10.0.0.255 via 203.0.113.1 to 8.8.8.8 8080"
source_fw: |
  @xdp(wan)
  snat to 203.0.113.1 if pkt.proto == tcp and pkt.src_ip in [10.0.0.0/8]
  allow
sequence:
  - name: outbound — translate and install the reply mapping
    builder: tcp(src_ip="10.0.0.255", dst_ip="8.8.8.8", src_port=51000, dst_port=8080, syn=true)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "203.0.113.1"
        dst_ip: "8.8.8.8"
        src_port: 51000
  - name: reply — de-NAT via the mapping step 1 installed
    builder: tcp(src_ip="8.8.8.8", dst_ip="203.0.113.1", src_port=8080, dst_port=51000, ack=true)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "8.8.8.8"
        dst_ip: "10.0.0.255"
        dst_port: 51000
