name: "nat install tcp 10.255.0.1 via 203.0.113.250 to 140.82.112.3 5353"
source_fw: |
  @xdp(wan)
  snat to 203.0.113.250 if pkt.proto == tcp and pkt.src_ip in [10.0.0.0/8]
  allow
sequence:
  - name: outbound — translate and install the reply mapping
    builder: tcp(src_ip="10.255.0.1", dst_ip="140.82.112.3", src_port=65535, dst_port=5353, syn=true)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "203.0.113.250"
        dst_ip: "140.82.112.3"
        src_port: 65535
  - name: reply — de-NAT via the mapping step 1 installed
    builder: tcp(src_ip="140.82.112.3", dst_ip="203.0.113.250", src_port=5353, dst_port=65535, ack=true)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "140.82.112.3"
        dst_ip: "10.255.0.1"
        dst_port: 65535
