name: "nat install udp 10.255.0.1 via 200.100.50.25 to 151.101.0.1 443"
source_fw: |
  @xdp(wan)
  snat to 200.100.50.25 if pkt.proto == udp and pkt.src_ip in [10.0.0.0/8]
  allow
sequence:
  - name: outbound — translate and install the reply mapping
    builder: udp(src_ip="10.255.0.1", dst_ip="151.101.0.1", src_port=33333, dst_port=443)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "200.100.50.25"
        dst_ip: "151.101.0.1"
        src_port: 33333
  - name: reply — de-NAT via the mapping step 1 installed
    builder: udp(src_ip="151.101.0.1", dst_ip="200.100.50.25", src_port=443, dst_port=33333)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "151.101.0.1"
        dst_ip: "10.255.0.1"
        dst_port: 33333
