name: "nat install udp 10.44.7.9 via 203.0.113.1 to 8.8.8.8 8080"
source_fw: |
  @xdp(wan)
  snat to 203.0.113.1 if pkt.proto == udp and pkt.src_ip in [10.0.0.0/8]
  allow
sequence:
  - name: outbound — translate and install the reply mapping
    builder: udp(src_ip="10.44.7.9", dst_ip="8.8.8.8", src_port=51000, dst_port=8080)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "203.0.113.1"
        dst_ip: "8.8.8.8"
        src_port: 51000
  - name: reply — de-NAT via the mapping step 1 installed
    builder: udp(src_ip="8.8.8.8", dst_ip="203.0.113.1", src_port=8080, dst_port=51000)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "8.8.8.8"
        dst_ip: "10.44.7.9"
        dst_port: 51000
