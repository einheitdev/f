name: "nat install udp 10.44.7.9 via 203.0.113.250 to 140.82.112.3 5353"
source_fw: |
  @xdp(wan)
  snat to 203.0.113.250 if pkt.proto == udp and pkt.src_ip in [10.0.0.0/8]
  allow
sequence:
  - name: outbound — translate and install the reply mapping
    builder: udp(src_ip="10.44.7.9", dst_ip="140.82.112.3", src_port=65535, dst_port=5353)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "203.0.113.250"
        dst_ip: "140.82.112.3"
        src_port: 65535
  - name: reply — de-NAT via the mapping step 1 installed
    builder: udp(src_ip="140.82.112.3", dst_ip="203.0.113.250", src_port=5353, dst_port=65535)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "140.82.112.3"
        dst_ip: "10.44.7.9"
        dst_port: 65535
