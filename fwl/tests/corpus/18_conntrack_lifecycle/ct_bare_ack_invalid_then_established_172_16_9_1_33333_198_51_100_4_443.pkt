name: "ct bare ack invalid then established 172.16.9.1 33333 198.51.100.4 443"
source_fw: |
  @xdp(eth0)
  drop if conntrack(pkt).state == invalid
  allow if conntrack(pkt).state == established
  allow if pkt.proto == tcp and pkt.tcp.syn and pkt.dst_port == 443
  default drop
sequence:
  - name: bare ack, no entry (invalid -> drop)
    builder: tcp(src_ip="172.16.9.1", dst_ip="198.51.100.4", src_port=33333, dst_port=443, ack=true)
    expected: { bpf_action: drop }
  - name: syn (new, allowed, creates entry)
    builder: tcp(src_ip="172.16.9.1", dst_ip="198.51.100.4", src_port=33333, dst_port=443, syn=true)
    expected: { bpf_action: allow }
  - name: same bare ack again (now established)
    builder: tcp(src_ip="172.16.9.1", dst_ip="198.51.100.4", src_port=33333, dst_port=443, ack=true)
    expected: { bpf_action: allow }
