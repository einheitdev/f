name: "ct bare ack invalid then established 192.168.4.20 51000 203.0.113.77 80"
source_fw: |
  @xdp(eth0)
  drop if conntrack(pkt).state == invalid
  allow if conntrack(pkt).state == established
  allow if pkt.proto == tcp and pkt.tcp.syn and pkt.dst_port == 80
  default drop
sequence:
  - name: bare ack, no entry (invalid -> drop)
    builder: tcp(src_ip="192.168.4.20", dst_ip="203.0.113.77", src_port=51000, dst_port=80, ack=true)
    expected: { bpf_action: drop }
  - name: syn (new, allowed, creates entry)
    builder: tcp(src_ip="192.168.4.20", dst_ip="203.0.113.77", src_port=51000, dst_port=80, syn=true)
    expected: { bpf_action: allow }
  - name: same bare ack again (now established)
    builder: tcp(src_ip="192.168.4.20", dst_ip="203.0.113.77", src_port=51000, dst_port=80, ack=true)
    expected: { bpf_action: allow }
