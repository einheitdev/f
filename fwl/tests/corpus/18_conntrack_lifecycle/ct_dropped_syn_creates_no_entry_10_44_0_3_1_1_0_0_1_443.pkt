name: "ct dropped syn creates no entry 10.44.0.3 1 1.0.0.1 443"
source_fw: |
  @xdp(eth0)
  allow if conntrack(pkt).state == established
  allow if pkt.proto == tcp and pkt.tcp.syn and pkt.dst_port == 53
  default drop
sequence:
  - name: syn to a blocked port (dropped)
    builder: tcp(src_ip="10.44.0.3", dst_ip="1.0.0.1", src_port=1, dst_port=443, syn=true)
    expected: { bpf_action: drop }
  - name: its reply must NOT be established
    builder: tcp(src_ip="1.0.0.1", dst_ip="10.44.0.3", src_port=443, dst_port=1, ack=true)
    expected: { bpf_action: drop }
