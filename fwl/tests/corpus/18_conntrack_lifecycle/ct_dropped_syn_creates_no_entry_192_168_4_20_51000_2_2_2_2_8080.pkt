name: "ct dropped syn creates no entry 192.168.4.20 51000 2.2.2.2 8080"
source_fw: |
  @xdp(eth0)
  allow if conntrack(pkt).state == established
  allow if pkt.proto == tcp and pkt.tcp.syn and pkt.dst_port == 443
  default drop
sequence:
  - name: syn to a blocked port (dropped)
    builder: tcp(src_ip="192.168.4.20", dst_ip="2.2.2.2", src_port=51000, dst_port=8080, syn=true)
    expected: { bpf_action: drop }
  - name: its reply must NOT be established
    builder: tcp(src_ip="2.2.2.2", dst_ip="192.168.4.20", src_port=8080, dst_port=51000, ack=true)
    expected: { bpf_action: drop }
