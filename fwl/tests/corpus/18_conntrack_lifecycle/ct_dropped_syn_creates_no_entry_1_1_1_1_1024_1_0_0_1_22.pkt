name: "ct dropped syn creates no entry 1.1.1.1 1024 1.0.0.1 22"
source_fw: |
  @xdp(eth0)
  allow if conntrack(pkt).state == established
  allow if pkt.proto == tcp and pkt.tcp.syn and pkt.dst_port == 8080
  default drop
sequence:
  - name: syn to a blocked port (dropped)
    builder: tcp(src_ip="1.1.1.1", dst_ip="1.0.0.1", src_port=1024, dst_port=22, syn=true)
    expected: { bpf_action: drop }
  - name: its reply must NOT be established
    builder: tcp(src_ip="1.0.0.1", dst_ip="1.1.1.1", src_port=22, dst_port=1024, ack=true)
    expected: { bpf_action: drop }
