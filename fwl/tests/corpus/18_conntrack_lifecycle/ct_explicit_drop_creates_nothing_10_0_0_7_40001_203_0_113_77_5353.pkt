name: "ct explicit drop creates nothing 10.0.0.7 40001 203.0.113.77 5353"
source_fw: |
  @xdp(eth0)
  allow if conntrack(pkt).state == established
  drop if pkt.proto == tcp and pkt.dst_port == 5353
  allow if pkt.proto == tcp and pkt.tcp.syn
  default drop
sequence:
  - name: syn to a blocked port — dropped by an explicit rule
    builder: tcp(src_ip="10.0.0.7", dst_ip="203.0.113.77", src_port=40001, dst_port=5353, syn=true)
    expected: { bpf_action: drop }
  - name: its reply must NOT read established
    builder: tcp(src_ip="203.0.113.77", dst_ip="10.0.0.7", src_port=5353, dst_port=40001, ack=true)
    expected: { bpf_action: drop }
