name: "ct explicit drop creates nothing 10.44.0.3 51000 93.184.216.34 80"
source_fw: |
  @xdp(eth0)
  allow if conntrack(pkt).state == established
  drop if pkt.proto == tcp and pkt.dst_port == 80
  allow if pkt.proto == tcp and pkt.tcp.syn
  default drop
sequence:
  - name: syn to a blocked port — dropped by an explicit rule
    builder: tcp(src_ip="10.44.0.3", dst_ip="93.184.216.34", src_port=51000, dst_port=80, syn=true)
    expected: { bpf_action: drop }
  - name: its reply must NOT read established
    builder: tcp(src_ip="93.184.216.34", dst_ip="10.44.0.3", src_port=80, dst_port=51000, ack=true)
    expected: { bpf_action: drop }
