name: "ct explicit drop creates nothing 172.16.9.1 1 8.8.8.8 22"
source_fw: |
  @xdp(eth0)
  allow if conntrack(pkt).state == established
  drop if pkt.proto == tcp and pkt.dst_port == 22
  allow if pkt.proto == tcp and pkt.tcp.syn
  default drop
sequence:
  - name: syn to a blocked port — dropped by an explicit rule
    builder: tcp(src_ip="172.16.9.1", dst_ip="8.8.8.8", src_port=1, dst_port=22, syn=true)
    expected: { bpf_action: drop }
  - name: its reply must NOT read established
    builder: tcp(src_ip="8.8.8.8", dst_ip="172.16.9.1", src_port=22, dst_port=1, ack=true)
    expected: { bpf_action: drop }
