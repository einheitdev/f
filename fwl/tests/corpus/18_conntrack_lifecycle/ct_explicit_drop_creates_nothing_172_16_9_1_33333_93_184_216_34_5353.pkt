name: "ct explicit drop creates nothing 172.16.9.1 33333 93.184.216.34 5353"
source_fw: |
  @xdp(eth0)
  allow if conntrack(pkt).state == established
  drop if pkt.proto == tcp and pkt.dst_port == 5353
  allow if pkt.proto == tcp and pkt.tcp.syn
  default drop
sequence:
  - name: syn to a blocked port — dropped by an explicit rule
    builder: tcp(src_ip="172.16.9.1", dst_ip="93.184.216.34", src_port=33333, dst_port=5353, syn=true)
    expected: { bpf_action: drop }
  - name: its reply must NOT read established
    builder: tcp(src_ip="93.184.216.34", dst_ip="172.16.9.1", src_port=5353, dst_port=33333, ack=true)
    expected: { bpf_action: drop }
