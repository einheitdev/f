name: "ct explicit drop creates nothing 192.168.100.200 51000 198.51.100.4 22"
source_fw: |
  @xdp(eth0)
  allow if conntrack(pkt).state == established
  drop if pkt.proto == tcp and pkt.dst_port == 22
  allow if pkt.proto == tcp and pkt.tcp.syn
  default drop
sequence:
  - name: syn to a blocked port — dropped by an explicit rule
    builder: tcp(src_ip="192.168.100.200", dst_ip="198.51.100.4", src_port=51000, dst_port=22, syn=true)
    expected: { bpf_action: drop }
  - name: its reply must NOT read established
    builder: tcp(src_ip="198.51.100.4", dst_ip="192.168.100.200", src_port=22, dst_port=51000, ack=true)
    expected: { bpf_action: drop }
