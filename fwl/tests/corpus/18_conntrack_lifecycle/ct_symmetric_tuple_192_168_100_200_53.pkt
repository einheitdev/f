name: "ct symmetric tuple 192.168.100.200 53"
source_fw: |
  @xdp(eth0)
  allow if conntrack(pkt).state == established
  allow if pkt.proto == tcp and pkt.tcp.syn and pkt.dst_port == 53
  default drop
sequence:
  - name: syn to self (new, allowed, creates entry)
    builder: tcp(src_ip="192.168.100.200", dst_ip="192.168.100.200", src_port=53, dst_port=53, syn=true)
    expected: { bpf_action: allow }
  - name: ack to self (forward and reverse are one key)
    builder: tcp(src_ip="192.168.100.200", dst_ip="192.168.100.200", src_port=53, dst_port=53, ack=true)
    expected: { bpf_action: allow }
