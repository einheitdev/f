name: "ct symmetric tuple 192.168.4.20 22"
source_fw: |
  @xdp(eth0)
  allow if conntrack(pkt).state == established
  allow if pkt.proto == tcp and pkt.tcp.syn and pkt.dst_port == 22
  default drop
sequence:
  - name: syn to self (new, allowed, creates entry)
    builder: tcp(src_ip="192.168.4.20", dst_ip="192.168.4.20", src_port=22, dst_port=22, syn=true)
    expected: { bpf_action: allow }
  - name: ack to self (forward and reverse are one key)
    builder: tcp(src_ip="192.168.4.20", dst_ip="192.168.4.20", src_port=22, dst_port=22, ack=true)
    expected: { bpf_action: allow }
