name: "ct tcp handshake 192.168.100.200 1 to 198.51.100.4 8080"
source_fw: |
  @xdp(eth0)
  allow if conntrack(pkt).state == established
  allow if pkt.proto == tcp and pkt.tcp.syn and pkt.dst_port == 8080
  default drop
sequence:
  - name: syn out (new, allowed, creates entry)
    builder: tcp(src_ip="192.168.100.200", dst_ip="198.51.100.4", src_port=1, dst_port=8080, syn=true)
    expected: { bpf_action: allow }
  - name: reply (established via the reverse tuple)
    builder: tcp(src_ip="198.51.100.4", dst_ip="192.168.100.200", src_port=8080, dst_port=1, ack=true)
    expected: { bpf_action: allow }
  - name: data out (established via the forward tuple)
    builder: tcp(src_ip="192.168.100.200", dst_ip="198.51.100.4", src_port=1, dst_port=8080, ack=true, psh=true)
    expected: { bpf_action: allow }
