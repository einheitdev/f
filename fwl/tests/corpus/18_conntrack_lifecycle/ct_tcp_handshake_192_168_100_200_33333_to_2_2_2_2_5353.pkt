name: "ct tcp handshake 192.168.100.200 33333 to 2.2.2.2 5353"
source_fw: |
  @xdp(eth0)
  allow if conntrack(pkt).state == established
  allow if pkt.proto == tcp and pkt.tcp.syn and pkt.dst_port == 5353
  default drop
sequence:
  - name: syn out (new, allowed, creates entry)
    builder: tcp(src_ip="192.168.100.200", dst_ip="2.2.2.2", src_port=33333, dst_port=5353, syn=true)
    expected: { bpf_action: allow }
  - name: reply (established via the reverse tuple)
    builder: tcp(src_ip="2.2.2.2", dst_ip="192.168.100.200", src_port=5353, dst_port=33333, ack=true)
    expected: { bpf_action: allow }
  - name: data out (established via the forward tuple)
    builder: tcp(src_ip="192.168.100.200", dst_ip="2.2.2.2", src_port=33333, dst_port=5353, ack=true, psh=true)
    expected: { bpf_action: allow }
