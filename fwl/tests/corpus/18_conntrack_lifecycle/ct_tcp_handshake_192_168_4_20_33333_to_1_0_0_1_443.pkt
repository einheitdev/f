name: "ct tcp handshake 192.168.4.20 33333 to 1.0.0.1 443"
source_fw: |
  @xdp(eth0)
  allow if conntrack(pkt).state == established
  allow if pkt.proto == tcp and pkt.tcp.syn and pkt.dst_port == 443
  default drop
sequence:
  - name: syn out (new, allowed, creates entry)
    builder: tcp(src_ip="192.168.4.20", dst_ip="1.0.0.1", src_port=33333, dst_port=443, syn=true)
    expected: { bpf_action: allow }
  - name: reply (established via the reverse tuple)
    builder: tcp(src_ip="1.0.0.1", dst_ip="192.168.4.20", src_port=443, dst_port=33333, ack=true)
    expected: { bpf_action: allow }
  - name: data out (established via the forward tuple)
    builder: tcp(src_ip="192.168.4.20", dst_ip="1.0.0.1", src_port=33333, dst_port=443, ack=true, psh=true)
    expected: { bpf_action: allow }
