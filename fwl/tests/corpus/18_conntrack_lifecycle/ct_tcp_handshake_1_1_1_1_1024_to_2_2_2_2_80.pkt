name: "ct tcp handshake 1.1.1.1 1024 to 2.2.2.2 80"
source_fw: |
  @xdp(eth0)
  allow if conntrack(pkt).state == established
  allow if pkt.proto == tcp and pkt.tcp.syn and pkt.dst_port == 80
  default drop
sequence:
  - name: syn out (new, allowed, creates entry)
    builder: tcp(src_ip="1.1.1.1", dst_ip="2.2.2.2", src_port=1024, dst_port=80, syn=true)
    expected: { bpf_action: allow }
  - name: reply (established via the reverse tuple)
    builder: tcp(src_ip="2.2.2.2", dst_ip="1.1.1.1", src_port=80, dst_port=1024, ack=true)
    expected: { bpf_action: allow }
  - name: data out (established via the forward tuple)
    builder: tcp(src_ip="1.1.1.1", dst_ip="2.2.2.2", src_port=1024, dst_port=80, ack=true, psh=true)
    expected: { bpf_action: allow }
