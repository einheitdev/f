name: "ct udp query reply 10.0.0.7 1 to 1.0.0.1 22"
source_fw: |
  @xdp(eth0)
  allow if conntrack(pkt).state == established
  allow if pkt.proto == udp and  pkt.dst_port == 22
  default drop
sequence:
  - name: query out (new, allowed, creates entry)
    builder: udp(src_ip="10.0.0.7", dst_ip="1.0.0.1", src_port=1, dst_port=22)
    expected: { bpf_action: allow }
  - name: reply (established via the reverse tuple)
    builder: udp(src_ip="1.0.0.1", dst_ip="10.0.0.7", src_port=22, dst_port=1)
    expected: { bpf_action: allow }
