name: "ct udp query reply 10.44.0.3 40001 to 198.51.100.4 8080"
source_fw: |
  @xdp(eth0)
  allow if conntrack(pkt).state == established
  allow if pkt.proto == udp and  pkt.dst_port == 8080
  default drop
sequence:
  - name: query out (new, allowed, creates entry)
    builder: udp(src_ip="10.44.0.3", dst_ip="198.51.100.4", src_port=40001, dst_port=8080)
    expected: { bpf_action: allow }
  - name: reply (established via the reverse tuple)
    builder: udp(src_ip="198.51.100.4", dst_ip="10.44.0.3", src_port=8080, dst_port=40001)
    expected: { bpf_action: allow }
