name: "ct udp query reply 172.16.9.1 1024 to 8.8.8.8 22"
source_fw: |
  @xdp(eth0)
  allow if conntrack(pkt).state == established
  allow if pkt.proto == udp and  pkt.dst_port == 22
  default drop
sequence:
  - name: query out (new, allowed, creates entry)
    builder: udp(src_ip="172.16.9.1", dst_ip="8.8.8.8", src_port=1024, dst_port=22)
    expected: { bpf_action: allow }
  - name: reply (established via the reverse tuple)
    builder: udp(src_ip="8.8.8.8", dst_ip="172.16.9.1", src_port=22, dst_port=1024)
    expected: { bpf_action: allow }
