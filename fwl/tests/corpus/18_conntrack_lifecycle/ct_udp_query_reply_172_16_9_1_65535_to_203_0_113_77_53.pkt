name: "ct udp query reply 172.16.9.1 65535 to 203.0.113.77 53"
source_fw: |
  @xdp(eth0)
  allow if conntrack(pkt).state == established
  allow if pkt.proto == udp and  pkt.dst_port == 53
  default drop
sequence:
  - name: query out (new, allowed, creates entry)
    builder: udp(src_ip="172.16.9.1", dst_ip="203.0.113.77", src_port=65535, dst_port=53)
    expected: { bpf_action: allow }
  - name: reply (established via the reverse tuple)
    builder: udp(src_ip="203.0.113.77", dst_ip="172.16.9.1", src_port=53, dst_port=65535)
    expected: { bpf_action: allow }
