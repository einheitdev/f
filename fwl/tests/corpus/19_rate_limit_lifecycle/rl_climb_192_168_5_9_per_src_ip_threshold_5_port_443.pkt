name: "rl climb 192.168.5.9 per src_ip threshold 5 port 443"
source_fw: |
  @xdp(eth0)
  drop if pkt.proto == tcp
       limited by rate_limit(5, per=src_ip)
  default allow
sequence:
  - name: packet 1 — bucket at 0, under the limit
    builder: tcp(src_ip="192.168.5.9", dst_ip="1.1.1.1", dst_port=443, syn=true)
    expected: { bpf_action: allow }
  - name: packet 2 — bucket at 1, under the limit
    builder: tcp(src_ip="192.168.5.9", dst_ip="1.1.1.1", dst_port=443, syn=true)
    expected: { bpf_action: allow }
  - name: packet 3 — bucket at 2, under the limit
    builder: tcp(src_ip="192.168.5.9", dst_ip="1.1.1.1", dst_port=443, syn=true)
    expected: { bpf_action: allow }
  - name: packet 4 — bucket at 3, under the limit
    builder: tcp(src_ip="192.168.5.9", dst_ip="1.1.1.1", dst_port=443, syn=true)
    expected: { bpf_action: allow }
  - name: packet 5 — bucket at 4, under the limit
    builder: tcp(src_ip="192.168.5.9", dst_ip="1.1.1.1", dst_port=443, syn=true)
    expected: { bpf_action: allow }
  - name: packet 6 — bucket at 5, limit reached
    builder: tcp(src_ip="192.168.5.9", dst_ip="1.1.1.1", dst_port=443, syn=true)
    expected: { bpf_action: drop }
