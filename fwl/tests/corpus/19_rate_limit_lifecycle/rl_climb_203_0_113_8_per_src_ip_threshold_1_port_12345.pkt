name: "rl climb 203.0.113.8 per src_ip threshold 1 port 12345"
source_fw: |
  @xdp(eth0)
  drop if pkt.proto == tcp
       limited by rate_limit(1, per=src_ip)
  default allow
sequence:
  - name: packet 1 — bucket at 0, under the limit
    builder: tcp(src_ip="203.0.113.8", dst_ip="151.101.0.1", dst_port=12345, syn=true)
    expected: { bpf_action: allow }
  - name: packet 2 — bucket at 1, limit reached
    builder: tcp(src_ip="203.0.113.8", dst_ip="151.101.0.1", dst_port=12345, syn=true)
    expected: { bpf_action: drop }
