name: "rl climb per dst_ip 1.1.1.1 from 203.0.113.8 port 12345"
source_fw: |
  @xdp(eth0)
  drop if pkt.proto == tcp
       limited by rate_limit(2, per=dst_ip)
  default allow
sequence:
  - name: packet 1 — bucket at 0
    builder: tcp(src_ip="203.0.113.8", dst_ip="1.1.1.1", dst_port=12345, syn=true)
    expected: { bpf_action: allow }
  - name: packet 2 — bucket at 1
    builder: tcp(src_ip="203.0.113.8", dst_ip="1.1.1.1", dst_port=12345, syn=true)
    expected: { bpf_action: allow }
  - name: packet 3 — bucket at 2, limit reached
    builder: tcp(src_ip="203.0.113.8", dst_ip="1.1.1.1", dst_port=12345, syn=true)
    expected: { bpf_action: drop }
