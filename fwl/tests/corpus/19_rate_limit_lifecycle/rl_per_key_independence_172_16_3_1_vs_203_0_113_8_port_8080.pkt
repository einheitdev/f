name: "rl per key independence 172.16.3.1 vs 203.0.113.8 port 8080"
source_fw: |
  @xdp(eth0)
  drop if pkt.proto == tcp
       limited by rate_limit(1, per=src_ip)
  default allow
sequence:
  - name: first source, first packet — allowed
    builder: tcp(src_ip="172.16.3.1", dst_ip="140.82.112.3", dst_port=8080, syn=true)
    expected: { bpf_action: allow }
  - name: first source again — its own bucket is full
    builder: tcp(src_ip="172.16.3.1", dst_ip="140.82.112.3", dst_port=8080, syn=true)
    expected: { bpf_action: drop }
  - name: second source — a different bucket, still empty
    builder: tcp(src_ip="203.0.113.8", dst_ip="140.82.112.3", dst_port=8080, syn=true)
    expected: { bpf_action: allow }
