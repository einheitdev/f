name: "rl per key independence 192.168.5.9 vs 172.16.3.1 port 22"
source_fw: |
  @xdp(eth0)
  drop if pkt.proto == tcp
       limited by rate_limit(1, per=src_ip)
  default allow
sequence:
  - name: first source, first packet — allowed
    builder: tcp(src_ip="192.168.5.9", dst_ip="1.1.1.1", dst_port=22, syn=true)
    expected: { bpf_action: allow }
  - name: first source again — its own bucket is full
    builder: tcp(src_ip="192.168.5.9", dst_ip="1.1.1.1", dst_port=22, syn=true)
    expected: { bpf_action: drop }
  - name: second source — a different bucket, still empty
    builder: tcp(src_ip="172.16.3.1", dst_ip="1.1.1.1", dst_port=22, syn=true)
    expected: { bpf_action: allow }
