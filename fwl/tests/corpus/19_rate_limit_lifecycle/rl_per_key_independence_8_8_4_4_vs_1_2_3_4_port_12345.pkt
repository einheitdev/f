name: "rl per key independence 8.8.4.4 vs 1.2.3.4 port 12345"
source_fw: |
  @xdp(eth0)
  drop if pkt.proto == tcp
       limited by rate_limit(1, per=src_ip)
  default allow
sequence:
  - name: first source, first packet — allowed
    builder: tcp(src_ip="8.8.4.4", dst_ip="208.67.222.222", dst_port=12345, syn=true)
    expected: { bpf_action: allow }
  - name: first source again — its own bucket is full
    builder: tcp(src_ip="8.8.4.4", dst_ip="208.67.222.222", dst_port=12345, syn=true)
    expected: { bpf_action: drop }
  - name: second source — a different bucket, still empty
    builder: tcp(src_ip="1.2.3.4", dst_ip="208.67.222.222", dst_port=12345, syn=true)
    expected: { bpf_action: allow }
