name: "rl side effect count 10.0.0.7 threshold 3 port 12345"
source_fw: |
  @xdp(eth0)
  count rl_hits if pkt.proto == tcp limited by rate_limit(3, per=src_ip)
  default allow
sequence:
  - name: "packet 1 — bucket at 0, under the limit, no count"
    builder: tcp(src_ip="10.0.0.7", dst_ip="93.184.216.34", dst_port=12345, syn=true)
    expected:
      bpf_action: allow
      counter_changes:
        rl_hits: 0
  - name: "packet 2 — bucket at 1, under the limit, no count"
    builder: tcp(src_ip="10.0.0.7", dst_ip="93.184.216.34", dst_port=12345, syn=true)
    expected:
      bpf_action: allow
      counter_changes:
        rl_hits: 0
  - name: "packet 3 — bucket at 2, under the limit, no count"
    builder: tcp(src_ip="10.0.0.7", dst_ip="93.184.216.34", dst_port=12345, syn=true)
    expected:
      bpf_action: allow
      counter_changes:
        rl_hits: 0
  - name: "packet 4 — bucket at 3, the gated count fires"
    builder: tcp(src_ip="10.0.0.7", dst_ip="93.184.216.34", dst_port=12345, syn=true)
    expected:
      bpf_action: allow
      counter_changes:
        rl_hits: 1
  - name: "packet 5 — still over, it fires again"
    builder: tcp(src_ip="10.0.0.7", dst_ip="93.184.216.34", dst_port=12345, syn=true)
    expected:
      bpf_action: allow
      counter_changes:
        rl_hits: 1
