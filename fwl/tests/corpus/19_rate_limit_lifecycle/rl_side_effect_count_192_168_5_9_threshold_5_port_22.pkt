name: "rl side effect count 192.168.5.9 threshold 5 port 22"
source_fw: |
  @xdp(eth0)
  count rl_hits if pkt.proto == tcp limited by rate_limit(5, per=src_ip)
  default allow
sequence:
  - name: "packet 1 — bucket at 0, under the limit, no count"
    builder: tcp(src_ip="192.168.5.9", dst_ip="1.1.1.1", dst_port=22, syn=true)
    expected:
      bpf_action: allow
      counter_changes:
        rl_hits: 0
  - name: "packet 2 — bucket at 1, under the limit, no count"
    builder: tcp(src_ip="192.168.5.9", dst_ip="1.1.1.1", dst_port=22, syn=true)
    expected:
      bpf_action: allow
      counter_changes:
        rl_hits: 0
  - name: "packet 3 — bucket at 2, under the limit, no count"
    builder: tcp(src_ip="192.168.5.9", dst_ip="1.1.1.1", dst_port=22, syn=true)
    expected:
      bpf_action: allow
      counter_changes:
        rl_hits: 0
  - name: "packet 4 — bucket at 3, under the limit, no count"
    builder: tcp(src_ip="192.168.5.9", dst_ip="1.1.1.1", dst_port=22, syn=true)
    expected:
      bpf_action: allow
      counter_changes:
        rl_hits: 0
  - name: "packet 5 — bucket at 4, under the limit, no count"
    builder: tcp(src_ip="192.168.5.9", dst_ip="1.1.1.1", dst_port=22, syn=true)
    expected:
      bpf_action: allow
      counter_changes:
        rl_hits: 0
  - name: "packet 6 — bucket at 5, the gated count fires"
    builder: tcp(src_ip="192.168.5.9", dst_ip="1.1.1.1", dst_port=22, syn=true)
    expected:
      bpf_action: allow
      counter_changes:
        rl_hits: 1
  - name: "packet 7 — still over, it fires again"
    builder: tcp(src_ip="192.168.5.9", dst_ip="1.1.1.1", dst_port=22, syn=true)
    expected:
      bpf_action: allow
      counter_changes:
        rl_hits: 1
