name: "zone compare dmz matches itself sp80"
source_fw: |
  zone wan = [wan0]
  zone lan = [lan0]
  zone dmz = [dmz0]
  zone guest = [guest0]
  @xdp(dmz)
  drop if pkt.zone == dmz
  allow
ingress_zone: dmz
test_packet:
  builder: tcp(src_ip="10.44.0.3", dst_ip="93.184.216.34", dst_port=80)
expected:
  compiles: true
  bpf_action: drop
