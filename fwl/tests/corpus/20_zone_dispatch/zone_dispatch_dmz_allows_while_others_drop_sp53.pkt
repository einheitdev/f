name: "zone dispatch dmz allows while others drop sp53"
source_fw: |
  zone wan = [wan0]
  zone lan = [lan0]
  zone dmz = [dmz0]
  zone guest = [guest0]
  @xdp(wan)
  drop
  @xdp(lan)
  drop
  @xdp(dmz)
  allow
  @xdp(guest)
  drop
ingress_zone: dmz
test_packet:
  builder: tcp(src_ip="172.20.1.9", dst_ip="93.184.216.34", dst_port=53)
expected:
  compiles: true
  bpf_action: allow
