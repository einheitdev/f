name: "zone dispatch guest allows while others drop sp80"
source_fw: |
  zone wan = [wan0]
  zone lan = [lan0]
  zone dmz = [dmz0]
  zone guest = [guest0]
  @xdp(wan)
  drop
  @xdp(lan)
  drop
  @xdp(dmz)
  drop
  @xdp(guest)
  allow
ingress_zone: guest
test_packet:
  builder: tcp(src_ip="172.20.1.9", dst_ip="93.184.216.34", dst_port=80)
expected:
  compiles: true
  bpf_action: allow
