name: "zone dispatch wan drops while others allow sp22"
source_fw: |
  zone wan = [wan0]
  zone lan = [lan0]
  zone dmz = [dmz0]
  zone guest = [guest0]
  @xdp(wan)
  drop
  @xdp(lan)
  allow
  @xdp(dmz)
  allow
  @xdp(guest)
  allow
ingress_zone: wan
test_packet:
  builder: tcp(src_ip="172.20.1.9", dst_ip="93.184.216.34", dst_port=22)
expected:
  compiles: true
  bpf_action: drop
