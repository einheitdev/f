name: "zone dispatch wan drops while others allow sp443"
source_fw: |
  zone wan = [wan0]
  zone lan = [lan0]
  zone dmz = [dmz0]
  zone guest = [guest0]
  @xdp(wan)
  drop
  @xdp(lan)
  allow
  @xdp(dmz)
  allow
  @xdp(guest)
  allow
ingress_zone: wan
test_packet:
  builder: tcp(src_ip="192.168.2.7", dst_ip="9.9.9.9", dst_port=443)
expected:
  compiles: true
  bpf_action: drop
