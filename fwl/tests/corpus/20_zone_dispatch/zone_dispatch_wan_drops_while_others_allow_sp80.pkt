name: "zone dispatch wan drops while others allow sp80"
source_fw: |
  zone wan = [wan0]
  zone lan = [lan0]
  zone dmz = [dmz0]
  zone guest = [guest0]
  @xdp(wan)
  drop
  @xdp(lan)
  allow
  @xdp(dmz)
  allow
  @xdp(guest)
  allow
ingress_zone: wan
test_packet:
  builder: tcp(src_ip="10.1.0.5", dst_ip="1.1.1.1", dst_port=80)
expected:
  compiles: true
  bpf_action: drop
