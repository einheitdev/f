name: "bare nat ipv4 header cut at 18 bytes"
source_fw: |
  @xdp(wan)
  masquerade
  allow
state:
  nat:
    masq_ip: "198.51.100.9"
# 18 bytes, and no prelude to early-out first: reaches `(void *)(ip + 1) > data_end` inside fwl_find_ipv4.
test_packet:
  builder: tcp(src_ip="192.168.1.50", dst_ip="8.8.8.8", dst_port=443, syn=true)
  truncate_to: 18
expected:
  compiles: true
  bpf_action: allow
