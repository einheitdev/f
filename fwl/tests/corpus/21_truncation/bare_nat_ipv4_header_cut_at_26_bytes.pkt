name: "bare nat ipv4 header cut at 26 bytes"
source_fw: |
  @xdp(wan)
  masquerade
  allow
state:
  nat:
    masq_ip: "198.51.100.9"
# 26 bytes, and no prelude to early-out first: reaches `(void *)(ip + 1) > data_end` inside fwl_find_ipv4.
test_packet:
  builder: tcp(src_ip="1.2.3.4", dst_ip="9.9.9.9", dst_port=443, syn=true)
  truncate_to: 26
expected:
  compiles: true
  bpf_action: allow
