name: "bare nat ipv4 header cut at 33 bytes"
source_fw: |
  @xdp(wan)
  masquerade
  allow
state:
  nat:
    masq_ip: "198.51.100.9"
# 33 bytes, and no prelude to early-out first: reaches `(void *)(ip + 1) > data_end` inside fwl_find_ipv4.
test_packet:
  builder: tcp(src_ip="10.255.0.1", dst_ip="208.67.222.222", dst_port=443, syn=true)
  truncate_to: 33
expected:
  compiles: true
  bpf_action: allow
