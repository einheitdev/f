name: "bare nat tagged frame cut in the tag at 15 bytes vlan 100"
source_fw: |
  @xdp(wan)
  masquerade
  allow
state:
  nat:
    masq_ip: "198.51.100.9"
# 15 bytes: reaches `(void *)(vh + 1) > data_end` — the NAT helper's own VLAN bounds check, a separate branch from the prelude's and one the prelude's early-out normally hides.
test_packet:
  builder: tcp(src_ip="192.168.1.50", dst_ip="8.8.8.8", dst_port=443, vlan_id=100, syn=true)
  truncate_to: 15
expected:
  compiles: true
  bpf_action: allow
