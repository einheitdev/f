name: "bare nat tagged frame cut in the tag at 16 bytes vlan 4094"
source_fw: |
  @xdp(wan)
  masquerade
  allow
state:
  nat:
    masq_ip: "198.51.100.9"
# 16 bytes: reaches `(void *)(vh + 1) > data_end` — the NAT helper's own VLAN bounds check, a separate branch from the prelude's and one the prelude's early-out normally hides.
test_packet:
  builder: tcp(src_ip="172.16.3.1", dst_ip="1.1.1.1", dst_port=443, vlan_id=4094, syn=true)
  truncate_to: 16
expected:
  compiles: true
  bpf_action: allow
