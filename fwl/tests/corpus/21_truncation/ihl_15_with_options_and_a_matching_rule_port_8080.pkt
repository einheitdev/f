name: "ihl 15 with options and a matching rule port 8080"
source_fw: |
  @xdp(eth0)
  drop if pkt.proto == tcp and pkt.dst_port == 8080
  default allow
# ihl=15 -> 40 bytes of options. L4 parses at ip + ip_hlen, so the port rule still fires and the packet is dropped — an emitter that assumed a fixed 20-byte header would read the options as a TCP header and allow it.
test_packet:
  builder: tcp(src_ip="203.0.113.8", dst_ip="140.82.112.3", dst_port=8080, ihl=15, syn=true)
expected:
  compiles: true
  bpf_action: drop
