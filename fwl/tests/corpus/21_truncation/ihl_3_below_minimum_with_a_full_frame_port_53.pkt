name: "ihl 3 below minimum with a full frame port 53"
source_fw: |
  @xdp(eth0)
  drop if pkt.proto == tcp and pkt.dst_port == 53
  default allow
# ihl=3 -> ip_hlen=12 < 20, so the emitted header-length guard is false and no L4 parse happens.
# v4_ok and `proto` are still set: the IP header itself is present, it just describes a shorter one.
test_packet:
  builder: tcp(src_ip="1.2.3.4", dst_ip="9.9.9.9", dst_port=53, ihl=3, syn=true)
expected:
  compiles: true
  bpf_action: allow
