name: "ihl 4 below minimum with a full frame port 8080"
source_fw: |
  @xdp(eth0)
  drop if pkt.proto == tcp and pkt.dst_port == 8080
  default allow
# ihl=4 -> ip_hlen=16 < 20, so the emitted header-length guard is false and no L4 parse happens.
# v4_ok and `proto` are still set: the IP header itself is present, it just describes a shorter one.
test_packet:
  builder: tcp(src_ip="203.0.113.8", dst_ip="140.82.112.3", dst_port=8080, ihl=4, syn=true)
expected:
  compiles: true
  bpf_action: allow
