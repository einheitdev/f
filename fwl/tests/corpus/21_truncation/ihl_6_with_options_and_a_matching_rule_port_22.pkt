name: "ihl 6 with options and a matching rule port 22"
source_fw: |
  @xdp(eth0)
  drop if pkt.proto == tcp and pkt.dst_port == 22
  default allow
# ihl=6 -> 4 bytes of options. L4 parses at ip + ip_hlen, so the port rule still fires and the packet is dropped — an emitter that assumed a fixed 20-byte header would read the options as a TCP header and allow it.
test_packet:
  builder: tcp(src_ip="10.0.0.7", dst_ip="93.184.216.34", dst_port=22, ihl=6, syn=true)
expected:
  compiles: true
  bpf_action: drop
