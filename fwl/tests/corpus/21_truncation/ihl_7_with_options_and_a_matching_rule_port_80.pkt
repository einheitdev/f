name: "ihl 7 with options and a matching rule port 80"
source_fw: |
  @xdp(eth0)
  drop if pkt.proto == tcp and pkt.dst_port == 80
  default allow
# ihl=7 -> 8 bytes of options. L4 parses at ip + ip_hlen, so the port rule still fires and the packet is dropped — an emitter that assumed a fixed 20-byte header would read the options as a TCP header and allow it.
test_packet:
  builder: tcp(src_ip="192.168.1.50", dst_ip="8.8.8.8", dst_port=80, ihl=7, syn=true)
expected:
  compiles: true
  bpf_action: drop
