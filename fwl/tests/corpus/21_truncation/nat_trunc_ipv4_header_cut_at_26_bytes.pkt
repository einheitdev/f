name: "nat trunc ipv4 header cut at 26 bytes"
source_fw: |
  @xdp(wan)
  masquerade if pkt.proto == tcp
  drop if pkt.proto == tcp and pkt.dst_port == 22
  default allow
state:
  nat:
    masq_ip: "198.51.100.9"
# 26 bytes: fwl_find_ipv4 bails, so `masquerade` is a no-op and the frame is forwarded untranslated.
test_packet:
  builder: tcp(src_ip="203.0.113.8", dst_ip="140.82.112.3", dst_port=443, syn=true)
  truncate_to: 26
expected:
  compiles: true
  bpf_action: allow
