name: "nat trunc ipv4 header cut at 29 bytes"
source_fw: |
  @xdp(wan)
  masquerade if pkt.proto == tcp
  drop if pkt.proto == tcp and pkt.dst_port == 22
  default allow
state:
  nat:
    masq_ip: "198.51.100.9"
# 29 bytes: fwl_find_ipv4 bails, so `masquerade` is a no-op and the frame is forwarded untranslated.
test_packet:
  builder: tcp(src_ip="10.255.0.1", dst_ip="208.67.222.222", dst_port=443, syn=true)
  truncate_to: 29
expected:
  compiles: true
  bpf_action: allow
