name: "nat trunc tagged frame cut in the tag at 14 bytes vlan 1"
source_fw: |
  @xdp(wan)
  masquerade if pkt.proto == tcp
  drop if pkt.proto == tcp and pkt.dst_port == 22
  default allow
state:
  nat:
    masq_ip: "198.51.100.9"
# 14 bytes: falsifies `(void *)(vh + 1) <= data_end` inside fwl_find_ipv4 — the NAT helper's own VLAN bounds check, which is a separate branch from the prelude's.
test_packet:
  builder: tcp(src_ip="10.0.0.7", dst_ip="93.184.216.34", dst_port=443, vlan_id=1, syn=true)
  truncate_to: 14
expected:
  compiles: true
  bpf_action: allow
