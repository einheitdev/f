name: "nat trunc tcp header cut at 38 bytes"
source_fw: |
  @xdp(wan)
  masquerade if pkt.proto == tcp
  drop if pkt.proto == tcp and pkt.dst_port == 22
  default allow
state:
  nat:
    masq_ip: "198.51.100.9"
# 38 bytes: the IPv4 header is complete but the TCP header is not, so fwl_snat_egress returns before installing a mapping.
test_packet:
  builder: tcp(src_ip="192.168.1.50", dst_ip="8.8.8.8", dst_port=443, syn=true)
  truncate_to: 38
expected:
  compiles: true
  bpf_action: allow
