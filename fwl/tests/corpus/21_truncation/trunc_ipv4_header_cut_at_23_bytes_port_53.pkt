name: "trunc ipv4 header cut at 23 bytes port 53"
source_fw: |
  @xdp(eth0)
  drop if pkt.proto == tcp and pkt.dst_port == 53
  default allow
# 23 bytes: the 14-byte Ethernet header fits, the 20-byte IPv4 header does not.
# v4_ok stays 0, so the prelude's non-IP early-out fires and the program returns XDP_PASS without consulting its default — which is why even the `default drop` variant expects allow.
test_packet:
  builder: tcp(src_ip="1.2.3.4", dst_ip="9.9.9.9", dst_port=53, syn=true)
  truncate_to: 23
expected:
  compiles: true
  bpf_action: allow
