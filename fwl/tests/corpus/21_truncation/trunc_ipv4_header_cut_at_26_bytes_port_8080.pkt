name: "trunc ipv4 header cut at 26 bytes port 8080"
source_fw: |
  @xdp(eth0)
  drop if pkt.proto == tcp
  default allow
# 26 bytes: the 14-byte Ethernet header fits, the 20-byte IPv4 header does not.
# v4_ok stays 0, so the prelude's non-IP early-out fires and the program returns XDP_PASS without consulting its default — which is why even the `default drop` variant expects allow.
test_packet:
  builder: tcp(src_ip="203.0.113.8", dst_ip="140.82.112.3", dst_port=8080, syn=true)
  truncate_to: 26
expected:
  compiles: true
  bpf_action: allow
