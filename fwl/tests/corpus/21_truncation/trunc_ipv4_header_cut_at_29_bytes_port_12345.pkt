name: "trunc ipv4 header cut at 29 bytes port 12345"
source_fw: |
  @xdp(eth0)
  allow if pkt.proto == tcp
  default drop
# 29 bytes: the 14-byte Ethernet header fits, the 20-byte IPv4 header does not.
# v4_ok stays 0, so the prelude's non-IP early-out fires and the program returns XDP_PASS without consulting its default — which is why even the `default drop` variant expects allow.
test_packet:
  builder: tcp(src_ip="10.255.0.1", dst_ip="208.67.222.222", dst_port=12345, syn=true)
  truncate_to: 29
expected:
  compiles: true
  bpf_action: allow
