name: "trunc ipv6 header cut at 29 bytes port 53"
source_fw: |
  @xdp(eth0)
  drop if pkt.src_ip6 in 2001:db8::1/128
  default allow
# 29 bytes: falsifies `(void *)(ip6 + 1) <= data_end` — 76 programs carry it and every one of them has only ever been sent a whole IPv6 frame.
test_packet:
  builder: tcp6(src_ip="2001:db8::1", dst_ip="2001:db8::2", dst_port=53, syn=true)
  truncate_to: 29
expected:
  compiles: true
  bpf_action: allow
