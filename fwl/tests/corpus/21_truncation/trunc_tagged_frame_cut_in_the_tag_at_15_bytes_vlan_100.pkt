name: "trunc tagged frame cut in the tag at 15 bytes vlan 100"
source_fw: |
  @xdp(eth0)
  drop if pkt.src_ip6 in 2001:db8:1::99/128
  drop if pkt.proto == tcp and pkt.dst_port == 22
  default allow
# 15 bytes: the 802.1Q tag needs 18. l3_proto is never re-read, so it stays 0x8100 — neither ETH_P_IP nor ETH_P_IPV6.
test_packet:
  builder: tcp6(src_ip="2001:db8:1::99", dst_ip="2606:4700::1111", dst_port=22, vlan_id=100, syn=true)
  truncate_to: 15
expected:
  compiles: true
  bpf_action: allow
