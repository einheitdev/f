name: "trunc tagged frame cut in the tag at 17 bytes vlan 1"
source_fw: |
  @xdp(eth0)
  drop if pkt.src_ip6 in 2001:db8::1/128
  drop if pkt.proto == tcp and pkt.dst_port == 22
  default allow
# 17 bytes: the 802.1Q tag needs 18. l3_proto is never re-read, so it stays 0x8100 — neither ETH_P_IP nor ETH_P_IPV6.
test_packet:
  builder: tcp6(src_ip="2001:db8::1", dst_ip="2001:db8::2", dst_port=22, vlan_id=1, syn=true)
  truncate_to: 17
expected:
  compiles: true
  bpf_action: allow
