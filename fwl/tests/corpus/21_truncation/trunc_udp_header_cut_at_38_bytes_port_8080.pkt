name: "trunc udp header cut at 38 bytes port 8080"
source_fw: |
  @xdp(eth0)
  drop if pkt.proto == udp and pkt.dst_port == 8080
  default allow
# 38 bytes: v4_ok is set, l4_ok is not — the UDP header needs 42.
# Falsifies `(void *)(udp + 1) <= data_end` (543 programs).
test_packet:
  builder: udp(src_ip="203.0.113.8", dst_ip="140.82.112.3", dst_port=8080)
  truncate_to: 38
expected:
  compiles: true
  bpf_action: allow
