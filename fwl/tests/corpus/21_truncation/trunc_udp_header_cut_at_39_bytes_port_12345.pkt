name: "trunc udp header cut at 39 bytes port 12345"
source_fw: |
  @xdp(eth0)
  allow if pkt.proto == udp and pkt.dst_port == 12345
  default drop
# 39 bytes: v4_ok is set, l4_ok is not — the UDP header needs 42.
# Falsifies `(void *)(udp + 1) <= data_end` (543 programs).
test_packet:
  builder: udp(src_ip="10.255.0.1", dst_ip="208.67.222.222", dst_port=12345)
  truncate_to: 39
expected:
  compiles: true
  bpf_action: drop
