name: "denat miss populated table 140.82.112.3 to 203.0.113.250 dp8080"
source_fw: |
  @xdp(wan)
  snat to 203.0.113.250 if pkt.proto == udp
  allow
state:
  nat:
    mappings:
      - { proto: tcp, src_ip: "208.67.222.222", dst_ip: "203.0.113.250", src_port: 80, dst_port: 8080, new_ip: "10.1.2.3", new_port: 8080, nat_type: dnat }
test_packet:
  builder: tcp(src_ip="140.82.112.3", dst_ip="203.0.113.250", src_port=80, dst_port=8080, syn=true)
expected:
  compiles: true
  bpf_action: allow
