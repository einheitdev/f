name: "denat miss populated table 1.1.1.1 to 198.51.100.255 dp53"
source_fw: |
  @xdp(wan)
  snat to 198.51.100.255 if pkt.proto == udp
  allow
state:
  nat:
    mappings:
      - { proto: tcp, src_ip: "140.82.112.3", dst_ip: "198.51.100.255", src_port: 80, dst_port: 53, new_ip: "172.16.0.9", new_port: 53, nat_type: dnat }
test_packet:
  builder: tcp(src_ip="1.1.1.1", dst_ip="198.51.100.255", src_port=80, dst_port=53, syn=true)
expected:
  compiles: true
  bpf_action: allow
