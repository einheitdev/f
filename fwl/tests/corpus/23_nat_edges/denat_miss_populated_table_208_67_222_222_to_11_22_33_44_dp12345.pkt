name: "denat miss populated table 208.67.222.222 to 11.22.33.44 dp12345"
source_fw: |
  @xdp(wan)
  snat to 11.22.33.44 if pkt.proto == udp
  allow
state:
  nat:
    mappings:
      - { proto: tcp, src_ip: "93.184.216.34", dst_ip: "11.22.33.44", src_port: 80, dst_port: 12345, new_ip: "10.255.0.1", new_port: 12345, nat_type: dnat }
test_packet:
  builder: tcp(src_ip="208.67.222.222", dst_ip="11.22.33.44", src_port=80, dst_port=12345, syn=true)
expected:
  compiles: true
  bpf_action: allow
