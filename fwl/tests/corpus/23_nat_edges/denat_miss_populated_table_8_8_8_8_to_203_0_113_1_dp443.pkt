name: "denat miss populated table 8.8.8.8 to 203.0.113.1 dp443"
source_fw: |
  @xdp(wan)
  snat to 203.0.113.1 if pkt.proto == udp
  allow
state:
  nat:
    mappings:
      - { proto: tcp, src_ip: "1.1.1.1", dst_ip: "203.0.113.1", src_port: 80, dst_port: 443, new_ip: "192.168.1.50", new_port: 443, nat_type: dnat }
test_packet:
  builder: tcp(src_ip="8.8.8.8", dst_ip="203.0.113.1", src_port=80, dst_port=443, syn=true)
expected:
  compiles: true
  bpf_action: allow
