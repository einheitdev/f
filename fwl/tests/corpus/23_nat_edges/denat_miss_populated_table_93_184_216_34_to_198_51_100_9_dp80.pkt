name: "denat miss populated table 93.184.216.34 to 198.51.100.9 dp80"
source_fw: |
  @xdp(wan)
  snat to 198.51.100.9 if pkt.proto == udp
  allow
state:
  nat:
    mappings:
      - { proto: tcp, src_ip: "8.8.8.8", dst_ip: "198.51.100.9", src_port: 80, dst_port: 80, new_ip: "10.0.0.5", new_port: 80, nat_type: dnat }
test_packet:
  builder: tcp(src_ip="93.184.216.34", dst_ip="198.51.100.9", src_port=80, dst_port=80, syn=true)
expected:
  compiles: true
  bpf_action: allow
