name: "denat snat type reply restores source 198.51.100.255 to 172.16.0.9"
source_fw: |
  @xdp(lan)
  dnat to 172.16.0.9:80 if pkt.proto == udp
  allow
state:
  nat:
    mappings:
      - { proto: tcp, src_ip: "172.16.0.9", dst_ip: "1.1.1.1", src_port: 53, dst_port: 80, new_ip: "198.51.100.255", new_port: 53, nat_type: snat }
test_packet:
  builder: tcp(src_ip="172.16.0.9", dst_ip="1.1.1.1", src_port=53, dst_port=80, syn=true)
expected:
  compiles: true
  bpf_action: allow
  output_packet:
    src_ip: "198.51.100.255"
    dst_ip: "1.1.1.1"
    src_port: 53
    dst_port: 80
