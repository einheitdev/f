name: "denat snat type reply restores source 198.51.100.9 to 10.0.0.5"
source_fw: |
  @xdp(lan)
  dnat to 10.0.0.5:80 if pkt.proto == udp
  allow
state:
  nat:
    mappings:
      - { proto: tcp, src_ip: "10.0.0.5", dst_ip: "93.184.216.34", src_port: 80, dst_port: 80, new_ip: "198.51.100.9", new_port: 80, nat_type: snat }
test_packet:
  builder: tcp(src_ip="10.0.0.5", dst_ip="93.184.216.34", src_port=80, dst_port=80, syn=true)
expected:
  compiles: true
  bpf_action: allow
  output_packet:
    src_ip: "198.51.100.9"
    dst_ip: "93.184.216.34"
    src_port: 80
    dst_port: 80
