name: "denat snat type reply restores source 203.0.113.1 to 192.168.1.50"
source_fw: |
  @xdp(lan)
  dnat to 192.168.1.50:80 if pkt.proto == udp
  allow
state:
  nat:
    mappings:
      - { proto: tcp, src_ip: "192.168.1.50", dst_ip: "8.8.8.8", src_port: 443, dst_port: 80, new_ip: "203.0.113.1", new_port: 443, nat_type: snat }
test_packet:
  builder: tcp(src_ip="192.168.1.50", dst_ip="8.8.8.8", src_port=443, dst_port=80, syn=true)
expected:
  compiles: true
  bpf_action: allow
  output_packet:
    src_ip: "203.0.113.1"
    dst_ip: "8.8.8.8"
    src_port: 443
    dst_port: 80
