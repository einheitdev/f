name: "denat snat type reply restores source 203.0.113.250 to 10.1.2.3"
source_fw: |
  @xdp(lan)
  dnat to 10.1.2.3:80 if pkt.proto == udp
  allow
state:
  nat:
    mappings:
      - { proto: tcp, src_ip: "10.1.2.3", dst_ip: "140.82.112.3", src_port: 8080, dst_port: 80, new_ip: "203.0.113.250", new_port: 8080, nat_type: snat }
test_packet:
  builder: tcp(src_ip="10.1.2.3", dst_ip="140.82.112.3", src_port=8080, dst_port=80, syn=true)
expected:
  compiles: true
  bpf_action: allow
  output_packet:
    src_ip: "203.0.113.250"
    dst_ip: "140.82.112.3"
    src_port: 8080
    dst_port: 80
