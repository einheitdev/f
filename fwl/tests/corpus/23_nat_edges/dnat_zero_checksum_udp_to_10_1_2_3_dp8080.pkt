name: "dnat zero checksum udp to 10.1.2.3 dp8080"
source_fw: |
  @xdp(wan)
  dnat to 10.1.2.3:8080 if pkt.proto == udp
  allow
test_packet:
  builder: udp(src_ip="140.82.112.3", dst_ip="203.0.113.250", src_port=40000, dst_port=53, udp_csum_zero=true)
expected:
  compiles: true
  bpf_action: allow
  output_packet:
    src_ip: "140.82.112.3"
    dst_ip: "10.1.2.3"
    src_port: 40000
    dst_port: 8080
