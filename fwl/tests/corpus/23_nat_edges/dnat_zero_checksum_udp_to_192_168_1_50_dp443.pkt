name: "dnat zero checksum udp to 192.168.1.50 dp443"
source_fw: |
  @xdp(wan)
  dnat to 192.168.1.50:443 if pkt.proto == udp
  allow
test_packet:
  builder: udp(src_ip="8.8.8.8", dst_ip="203.0.113.1", src_port=40000, dst_port=53, udp_csum_zero=true)
expected:
  compiles: true
  bpf_action: allow
  output_packet:
    src_ip: "8.8.8.8"
    dst_ip: "192.168.1.50"
    src_port: 40000
    dst_port: 443
