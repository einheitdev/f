name: "snat zero checksum udp 10.1.2.3 to 203.0.113.250 dp8080"
source_fw: |
  @xdp(lan)
  snat to 203.0.113.250 if pkt.proto == udp
  allow
test_packet:
  builder: udp(src_ip="10.1.2.3", dst_ip="140.82.112.3", src_port=12345, dst_port=8080, udp_csum_zero=true)
expected:
  compiles: true
  bpf_action: allow
  output_packet:
    src_ip: "203.0.113.250"
    dst_ip: "140.82.112.3"
    src_port: 12345
    dst_port: 8080
