name: "snat zero checksum udp 10.255.0.1 to 11.22.33.44 dp12345"
source_fw: |
  @xdp(lan)
  snat to 11.22.33.44 if pkt.proto == udp
  allow
test_packet:
  builder: udp(src_ip="10.255.0.1", dst_ip="208.67.222.222", src_port=12345, dst_port=12345, udp_csum_zero=true)
expected:
  compiles: true
  bpf_action: allow
  output_packet:
    src_ip: "11.22.33.44"
    dst_ip: "208.67.222.222"
    src_port: 12345
    dst_port: 12345
