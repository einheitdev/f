name: "snat zero checksum udp 172.16.0.9 to 198.51.100.255 dp53"
source_fw: |
  @xdp(lan)
  snat to 198.51.100.255 if pkt.proto == udp
  allow
test_packet:
  builder: udp(src_ip="172.16.0.9", dst_ip="1.1.1.1", src_port=12345, dst_port=53, udp_csum_zero=true)
expected:
  compiles: true
  bpf_action: allow
  output_packet:
    src_ip: "198.51.100.255"
    dst_ip: "1.1.1.1"
    src_port: 12345
    dst_port: 53
