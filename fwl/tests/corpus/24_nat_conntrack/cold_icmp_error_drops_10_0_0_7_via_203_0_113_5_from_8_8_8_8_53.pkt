name: "cold icmp error drops 10.0.0.7 via 203.0.113.5 from 8.8.8.8 53"
source_fw: |
  @xdp(lan)
  masquerade if pkt.src_ip in [10.0.0.0/8]
  allow if pkt.proto == tcp and pkt.tcp.syn
  allow if conntrack(pkt).state in [established, related]
  default drop
state:
  nat:
    masq_ip: "203.0.113.5"
sequence:
  - name: an error naming a flow nothing ever opened — no entry under the embedded tuple, so RELATED cannot match either
    builder: icmperr(src_ip="192.0.2.1", dst_ip="203.0.113.5", type=3, code=4, mtu=1400, inner_proto="tcp", inner_src_ip="203.0.113.5", inner_dst_ip="8.8.8.8", inner_src_port=51000, inner_dst_port=53)
    expected:
      bpf_action: drop
