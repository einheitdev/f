name: "cold reply drops 10.1.2.3 via 200.100.50.25 from 151.101.0.1 443"
source_fw: |
  @xdp(lan)
  masquerade if pkt.src_ip in [10.0.0.0/8]
  allow if pkt.proto == tcp and pkt.tcp.syn
  allow if conntrack(pkt).state == established
  default drop
state:
  nat:
    masq_ip: "200.100.50.25"
sequence:
  - name: a reply with no flow behind it — nothing tracked it, so ESTABLISHED cannot match and default drop takes it
    builder: tcp(src_ip="151.101.0.1", dst_ip="200.100.50.25", src_port=443, dst_port=33333, ack=true)
    expected:
      bpf_action: drop
