name: "cold reply drops 172.16.9.1 via 203.0.113.5 from 8.8.8.8 53"
source_fw: |
  @xdp(lan)
  masquerade if pkt.src_ip in [172.16.0.0/12]
  allow if pkt.proto == tcp and pkt.tcp.syn
  allow if conntrack(pkt).state == established
  default drop
state:
  nat:
    masq_ip: "203.0.113.5"
sequence:
  - name: a reply with no flow behind it — nothing tracked it, so ESTABLISHED cannot match and default drop takes it
    builder: tcp(src_ip="8.8.8.8", dst_ip="203.0.113.5", src_port=53, dst_port=51000, ack=true)
    expected:
      bpf_action: drop
