name: "cold reply drops 192.168.4.20 via 11.22.33.44 from 140.82.112.3 5353"
source_fw: |
  @xdp(lan)
  masquerade if pkt.src_ip in [192.168.0.0/16]
  allow if pkt.proto == tcp and pkt.tcp.syn
  allow if conntrack(pkt).state == established
  default drop
state:
  nat:
    masq_ip: "11.22.33.44"
sequence:
  - name: a reply with no flow behind it — nothing tracked it, so ESTABLISHED cannot match and default drop takes it
    builder: tcp(src_ip="140.82.112.3", dst_ip="11.22.33.44", src_port=5353, dst_port=65535, ack=true)
    expected:
      bpf_action: drop
