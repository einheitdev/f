name: "established alone rejects the error 192.168.4.20 via 203.0.113.250 from 1.1.1.1 22"
source_fw: |
  @xdp(lan)
  masquerade if pkt.src_ip in [192.168.0.0/16]
  allow if pkt.proto == tcp and pkt.tcp.syn
  allow if conntrack(pkt).state == established
  default drop
state:
  nat:
    masq_ip: "203.0.113.250"
sequence:
  - name: outbound SYN — the flow is open and tracked
    builder: tcp(src_ip="192.168.4.20", dst_ip="1.1.1.1", src_port=1024, dst_port=22, syn=true)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "203.0.113.250"
        dst_ip: "1.1.1.1"
        src_port: 1024
  - name: its frag-needed under a policy that lists only `established` — the error is RELATED, which that list does not contain, so default drop takes it
    builder: icmperr(src_ip="192.0.2.1", dst_ip="203.0.113.250", type=3, code=4, mtu=1400, inner_proto="tcp", inner_src_ip="203.0.113.250", inner_dst_ip="1.1.1.1", inner_src_port=1024, inner_dst_port=22)
    expected:
      bpf_action: drop
