name: "forged icmp query not related 192.168.100.200 via 198.51.100.9 from 93.184.216.34 8080"
source_fw: |
  @xdp(lan)
  masquerade if pkt.src_ip in [192.168.0.0/16]
  allow if pkt.proto == tcp and pkt.tcp.syn
  allow if conntrack(pkt).state in [established, related]
  default drop
state:
  nat:
    masq_ip: "198.51.100.9"
sequence:
  - name: outbound SYN — the flow is open and its header is now public knowledge, having crossed the wire
    builder: tcp(src_ip="192.168.100.200", dst_ip="93.184.216.34", src_port=40001, dst_port=8080, syn=true)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "198.51.100.9"
        dst_ip: "93.184.216.34"
        src_port: 40001
  - name: an echo REQUEST carrying a copy of that header as its payload. Everything an error-reader looks at is there and correct; only the type says query. It is not RELATED to anything, and default drop takes it
    builder: icmperr(src_ip="93.184.216.34", dst_ip="198.51.100.9", type=8, code=0, mtu=1400, inner_proto="tcp", inner_src_ip="198.51.100.9", inner_dst_ip="93.184.216.34", inner_src_port=40001, inner_dst_port=8080)
    expected:
      bpf_action: drop
