name: "an icmp error carrying a masqueraded UDP datagram reaches its sender"
source_fw: |
  @xdp(lan)
  masquerade if pkt.src_ip in [10.0.0.0/8]
  allow if pkt.proto == udp and pkt.src_ip in [10.0.0.0/8]
  allow if conntrack(pkt).state in [established, related]
  default drop
state:
  nat:
    masq_ip: "198.51.100.9"
sequence:
  - name: an outbound UDP flow — QUIC-shaped, the traffic for which path-MTU discovery is the only feedback there is
    builder: udp(src_ip="10.1.2.3", dst_ip="140.82.112.3", src_port=51000, dst_port=443)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "198.51.100.9"
        dst_ip: "140.82.112.3"
        src_port: 51000
  - name: the frag-needed about it, carrying the UDP header the NAT emitted. The embedded transport checksum is deliberately not rewritten — only 8 bytes of it travel, so it covers a payload the error does not carry
    builder: icmperr(src_ip="192.0.2.1", dst_ip="198.51.100.9", type=3, code=4, mtu=1400, inner_proto="udp", inner_src_ip="198.51.100.9", inner_dst_ip="140.82.112.3", inner_src_port=51000, inner_dst_port=443)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "192.0.2.1"
        dst_ip: "10.1.2.3"
        inner_src_ip: "10.1.2.3"
        inner_dst_ip: "140.82.112.3"
        inner_src_port: 51000
        inner_dst_port: 443
