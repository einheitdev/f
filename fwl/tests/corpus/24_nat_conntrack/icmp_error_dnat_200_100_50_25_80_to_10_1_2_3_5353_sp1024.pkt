name: "icmp error dnat 200.100.50.25 80 to 10.1.2.3 5353 sp1024"
source_fw: |
  @xdp(lan)
  dnat to 10.1.2.3:5353 if pkt.proto == tcp and pkt.dst_port == 80
  allow if pkt.proto == tcp and pkt.tcp.syn
  allow if conntrack(pkt).state in [established, related]
  default drop
sequence:
  - name: inbound SYN — DNAT'd to the backend and tracked
    builder: tcp(src_ip="93.184.216.34", dst_ip="200.100.50.25", src_port=1024, dst_port=80, syn=true)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "93.184.216.34"
        dst_ip: "10.1.2.3"
        dst_port: 5353
  - name: the error about it, leaving — outer source and BOTH embedded endpoint fields restored to the published ones
    builder: icmperr(src_ip="10.1.2.3", dst_ip="93.184.216.34", type=3, code=4, mtu=1400, inner_proto="tcp", inner_src_ip="93.184.216.34", inner_dst_ip="10.1.2.3", inner_src_port=1024, inner_dst_port=5353)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "200.100.50.25"
        dst_ip: "93.184.216.34"
        inner_src_ip: "93.184.216.34"
        inner_dst_ip: "200.100.50.25"
        inner_src_port: 1024
        inner_dst_port: 80
