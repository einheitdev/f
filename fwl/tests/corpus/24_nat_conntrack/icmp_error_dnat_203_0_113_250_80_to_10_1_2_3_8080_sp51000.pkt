name: "icmp error dnat 203.0.113.250 80 to 10.1.2.3 8080 sp51000"
source_fw: |
  @xdp(lan)
  dnat to 10.1.2.3:8080 if pkt.proto == tcp and pkt.dst_port == 80
  allow if pkt.proto == tcp and pkt.tcp.syn
  allow if conntrack(pkt).state in [established, related]
  default drop
sequence:
  - name: inbound SYN — DNAT'd to the backend and tracked
    builder: tcp(src_ip="208.67.222.222", dst_ip="203.0.113.250", src_port=51000, dst_port=80, syn=true)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "208.67.222.222"
        dst_ip: "10.1.2.3"
        dst_port: 8080
  - name: the error about it, leaving — outer source and BOTH embedded endpoint fields restored to the published ones
    builder: icmperr(src_ip="10.1.2.3", dst_ip="208.67.222.222", type=3, code=4, mtu=1400, inner_proto="tcp", inner_src_ip="208.67.222.222", inner_dst_ip="10.1.2.3", inner_src_port=51000, inner_dst_port=8080)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "203.0.113.250"
        dst_ip: "208.67.222.222"
        inner_src_ip: "208.67.222.222"
        inner_dst_ip: "203.0.113.250"
        inner_src_port: 51000
        inner_dst_port: 80
