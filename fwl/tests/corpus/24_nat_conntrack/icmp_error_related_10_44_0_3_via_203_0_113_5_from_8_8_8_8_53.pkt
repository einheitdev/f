name: "icmp error related 10.44.0.3 via 203.0.113.5 from 8.8.8.8 53"
source_fw: |
  @xdp(lan)
  masquerade if pkt.src_ip in [10.0.0.0/8]
  allow if pkt.proto == tcp and pkt.tcp.syn
  allow if conntrack(pkt).state in [established, related]
  default drop
state:
  nat:
    masq_ip: "203.0.113.5"
sequence:
  - name: outbound SYN — translated, and the POST-NAT tuple tracked
    builder: tcp(src_ip="10.44.0.3", dst_ip="8.8.8.8", src_port=51000, dst_port=53, syn=true)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "203.0.113.5"
        dst_ip: "8.8.8.8"
        src_port: 51000
  - name: the frag-needed about that flow — RELATED off the embedded datagram, and translated in BOTH headers
    builder: icmperr(src_ip="192.0.2.1", dst_ip="203.0.113.5", type=3, code=4, mtu=1400, inner_proto="tcp", inner_src_ip="203.0.113.5", inner_dst_ip="8.8.8.8", inner_src_port=51000, inner_dst_port=53)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "192.0.2.1"
        dst_ip: "10.44.0.3"
        inner_src_ip: "10.44.0.3"
        inner_dst_ip: "8.8.8.8"
        inner_src_port: 51000
        inner_dst_port: 53
