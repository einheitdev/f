name: "icmp error related 192.168.4.20 via 200.100.50.25 from 151.101.0.1 443"
source_fw: |
  @xdp(lan)
  masquerade if pkt.src_ip in [192.168.0.0/16]
  allow if pkt.proto == tcp and pkt.tcp.syn
  allow if conntrack(pkt).state in [established, related]
  default drop
state:
  nat:
    masq_ip: "200.100.50.25"
sequence:
  - name: outbound SYN — translated, and the POST-NAT tuple tracked
    builder: tcp(src_ip="192.168.4.20", dst_ip="151.101.0.1", src_port=33333, dst_port=443, syn=true)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "200.100.50.25"
        dst_ip: "151.101.0.1"
        src_port: 33333
  - name: the frag-needed about that flow — RELATED off the embedded datagram, and translated in BOTH headers
    builder: icmperr(src_ip="192.0.2.1", dst_ip="200.100.50.25", type=3, code=4, mtu=1400, inner_proto="tcp", inner_src_ip="200.100.50.25", inner_dst_ip="151.101.0.1", inner_src_port=33333, inner_dst_port=443)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "192.0.2.1"
        dst_ip: "192.168.4.20"
        inner_src_ip: "192.168.4.20"
        inner_dst_ip: "151.101.0.1"
        inner_src_port: 33333
        inner_dst_port: 443
