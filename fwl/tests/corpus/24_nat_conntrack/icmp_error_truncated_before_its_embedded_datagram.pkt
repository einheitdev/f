name: "an icmp error cut before its embedded datagram names no flow"
source_fw: |
  @xdp(lan)
  masquerade if pkt.src_ip in [10.0.0.0/8]
  allow if pkt.proto == tcp and pkt.tcp.syn
  allow if conntrack(pkt).state in [established, related]
  default drop
state:
  nat:
    masq_ip: "203.0.113.5"
sequence:
  - name: the flow is open, so a classifier that guessed would have something to guess at
    builder: tcp(src_ip="10.0.0.7", dst_ip="8.8.8.8", src_port=40000, dst_port=443, syn=true)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "203.0.113.5"
        src_port: 40000
  - name: the same error cut to 60 bytes — the ICMP header is readable and its type still says "error", but the embedded datagram is not all there. A classifier that read the type and then trusted the bytes behind it would fabricate a tuple out of whatever the frame ended with; there is nothing to read, so it is NEW and default drop takes it
    builder: icmperr(src_ip="192.0.2.1", dst_ip="203.0.113.5", type=3, code=4, mtu=1400, inner_src_ip="203.0.113.5", inner_dst_ip="8.8.8.8", inner_src_port=40000, inner_dst_port=443)
    truncate_to: 60
    expected:
      bpf_action: drop
