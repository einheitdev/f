name: "masq established 192.168.100.200 via 198.51.100.9 to 93.184.216.34 8080"
source_fw: |
  @xdp(lan)
  masquerade if pkt.src_ip in [192.168.0.0/16]
  allow if pkt.proto == tcp and pkt.tcp.syn
  allow if conntrack(pkt).state == established
  default drop
state:
  nat:
    masq_ip: "198.51.100.9"
sequence:
  - name: outbound SYN — translated, and the POST-NAT tuple tracked
    builder: tcp(src_ip="192.168.100.200", dst_ip="93.184.216.34", src_port=40001, dst_port=8080, syn=true)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "198.51.100.9"
        dst_ip: "93.184.216.34"
        src_port: 40001
  - name: reply as the wire delivers it — reads ESTABLISHED under the post-NAT key, and is delivered de-NAT'd
    builder: tcp(src_ip="93.184.216.34", dst_ip="198.51.100.9", src_port=8080, dst_port=40001, ack=true)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "93.184.216.34"
        dst_ip: "192.168.100.200"
        dst_port: 40001
