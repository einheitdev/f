name: "masq established 192.168.100.200 via 203.0.113.250 to 1.1.1.1 22"
source_fw: |
  @xdp(lan)
  masquerade if pkt.src_ip in [192.168.0.0/16]
  allow if pkt.proto == tcp and pkt.tcp.syn
  allow if conntrack(pkt).state == established
  default drop
state:
  nat:
    masq_ip: "203.0.113.250"
sequence:
  - name: outbound SYN — translated, and the POST-NAT tuple tracked
    builder: tcp(src_ip="192.168.100.200", dst_ip="1.1.1.1", src_port=1024, dst_port=22, syn=true)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "203.0.113.250"
        dst_ip: "1.1.1.1"
        src_port: 1024
  - name: reply as the wire delivers it — reads ESTABLISHED under the post-NAT key, and is delivered de-NAT'd
    builder: tcp(src_ip="1.1.1.1", dst_ip="203.0.113.250", src_port=22, dst_port=1024, ack=true)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "1.1.1.1"
        dst_ip: "192.168.100.200"
        dst_port: 1024
