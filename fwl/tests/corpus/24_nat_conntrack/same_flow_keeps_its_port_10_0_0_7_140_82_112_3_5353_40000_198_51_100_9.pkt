name: "same flow keeps its port 10.0.0.7 to 140.82.112.3 5353"
source_fw: |
  @xdp(lan)
  masquerade if pkt.src_ip in [10.0.0.0/8]
  allow if pkt.proto == tcp and pkt.tcp.syn
  allow if conntrack(pkt).state == established
  default drop
state:
  nat:
    masq_ip: "198.51.100.9"
sequence:
  - name: the SYN claims the mapping, port preserved
    builder: tcp(src_ip="10.0.0.7", dst_ip="140.82.112.3", src_port=40000, dst_port=5353, syn=true)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "198.51.100.9"
        src_port: 40000
  - name: a later packet of the same flow finds its OWN mapping — not a collision, so the port does not move
    builder: tcp(src_ip="10.0.0.7", dst_ip="140.82.112.3", src_port=40000, dst_port=5353, ack=true)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "198.51.100.9"
        src_port: 40000
  - name: and the reply still resolves to the one original port
    builder: tcp(src_ip="140.82.112.3", dst_ip="198.51.100.9", src_port=5353, dst_port=40000, ack=true)
    expected:
      bpf_action: allow
      output_packet:
        dst_ip: "10.0.0.7"
        dst_port: 40000
