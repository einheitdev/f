name: "snat established 10.44.0.3 via 198.51.100.255 to 8.8.8.8 5353"
source_fw: |
  @xdp(lan)
  snat to 198.51.100.255 if pkt.src_ip in [10.0.0.0/8]
  allow if pkt.proto == tcp and pkt.tcp.syn
  allow if conntrack(pkt).state == established
  default drop
sequence:
  - name: outbound SYN — translated, and the POST-NAT tuple tracked
    builder: tcp(src_ip="10.44.0.3", dst_ip="8.8.8.8", src_port=1024, dst_port=5353, syn=true)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "198.51.100.255"
        dst_ip: "8.8.8.8"
        src_port: 1024
  - name: reply — ESTABLISHED under the post-NAT key, de-NAT'd home
    builder: tcp(src_ip="8.8.8.8", dst_ip="198.51.100.255", src_port=5353, dst_port=1024, ack=true)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "8.8.8.8"
        dst_ip: "10.44.0.3"
        dst_port: 1024
