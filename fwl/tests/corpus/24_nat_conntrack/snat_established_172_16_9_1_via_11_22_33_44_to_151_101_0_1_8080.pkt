name: "snat established 172.16.9.1 via 11.22.33.44 to 151.101.0.1 8080"
source_fw: |
  @xdp(lan)
  snat to 11.22.33.44 if pkt.src_ip in [172.16.0.0/12]
  allow if pkt.proto == tcp and pkt.tcp.syn
  allow if conntrack(pkt).state == established
  default drop
sequence:
  - name: outbound SYN — translated, and the POST-NAT tuple tracked
    builder: tcp(src_ip="172.16.9.1", dst_ip="151.101.0.1", src_port=51000, dst_port=8080, syn=true)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "11.22.33.44"
        dst_ip: "151.101.0.1"
        src_port: 51000
  - name: reply — ESTABLISHED under the post-NAT key, de-NAT'd home
    builder: tcp(src_ip="151.101.0.1", dst_ip="11.22.33.44", src_port=8080, dst_port=51000, ack=true)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "151.101.0.1"
        dst_ip: "172.16.9.1"
        dst_port: 51000
