name: "snat established 192.168.100.200 via 200.100.50.25 to 208.67.222.222 22"
source_fw: |
  @xdp(lan)
  snat to 200.100.50.25 if pkt.src_ip in [192.168.0.0/16]
  allow if pkt.proto == tcp and pkt.tcp.syn
  allow if conntrack(pkt).state == established
  default drop
sequence:
  - name: outbound SYN — translated, and the POST-NAT tuple tracked
    builder: tcp(src_ip="192.168.100.200", dst_ip="208.67.222.222", src_port=40001, dst_port=22, syn=true)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "200.100.50.25"
        dst_ip: "208.67.222.222"
        src_port: 40001
  - name: reply — ESTABLISHED under the post-NAT key, de-NAT'd home
    builder: tcp(src_ip="208.67.222.222", dst_ip="200.100.50.25", src_port=22, dst_port=40001, ack=true)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "208.67.222.222"
        dst_ip: "192.168.100.200"
        dst_port: 40001
