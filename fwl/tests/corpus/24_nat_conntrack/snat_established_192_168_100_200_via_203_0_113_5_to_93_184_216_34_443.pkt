name: "snat established 192.168.100.200 via 203.0.113.5 to 93.184.216.34 443"
source_fw: |
  @xdp(lan)
  snat to 203.0.113.5 if pkt.src_ip in [192.168.0.0/16]
  allow if pkt.proto == tcp and pkt.tcp.syn
  allow if conntrack(pkt).state == established
  default drop
sequence:
  - name: outbound SYN — translated, and the POST-NAT tuple tracked
    builder: tcp(src_ip="192.168.100.200", dst_ip="93.184.216.34", src_port=65535, dst_port=443, syn=true)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "203.0.113.5"
        dst_ip: "93.184.216.34"
        src_port: 65535
  - name: reply — ESTABLISHED under the post-NAT key, de-NAT'd home
    builder: tcp(src_ip="93.184.216.34", dst_ip="203.0.113.5", src_port=443, dst_port=65535, ack=true)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "93.184.216.34"
        dst_ip: "192.168.100.200"
        dst_port: 65535
