name: "udp masq established 172.16.9.1 via 11.22.33.44 to 208.67.222.222 443"
source_fw: |
  @xdp(lan)
  masquerade if pkt.src_ip in [172.16.0.0/12]
  allow if pkt.proto == udp and pkt.src_ip in [172.16.0.0/12]
  allow if conntrack(pkt).state == established
  default drop
state:
  nat:
    masq_ip: "11.22.33.44"
sequence:
  - name: outbound — translated, and the POST-NAT tuple tracked
    builder: udp(src_ip="172.16.9.1", dst_ip="208.67.222.222", src_port=33333, dst_port=443)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "11.22.33.44"
        dst_ip: "208.67.222.222"
        src_port: 33333
  - name: reply — ESTABLISHED under the post-NAT key, de-NAT'd home
    builder: udp(src_ip="208.67.222.222", dst_ip="11.22.33.44", src_port=443, dst_port=33333)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "208.67.222.222"
        dst_ip: "172.16.9.1"
        dst_port: 33333
