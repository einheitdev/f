name: "udp masq established 172.16.9.1 via 198.51.100.9 to 140.82.112.3 22"
source_fw: |
  @xdp(lan)
  masquerade if pkt.src_ip in [172.16.0.0/12]
  allow if pkt.proto == udp and pkt.src_ip in [172.16.0.0/12]
  allow if conntrack(pkt).state == established
  default drop
state:
  nat:
    masq_ip: "198.51.100.9"
sequence:
  - name: outbound — translated, and the POST-NAT tuple tracked
    builder: udp(src_ip="172.16.9.1", dst_ip="140.82.112.3", src_port=1024, dst_port=22)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "198.51.100.9"
        dst_ip: "140.82.112.3"
        src_port: 1024
  - name: reply — ESTABLISHED under the post-NAT key, de-NAT'd home
    builder: udp(src_ip="140.82.112.3", dst_ip="198.51.100.9", src_port=22, dst_port=1024)
    expected:
      bpf_action: allow
      output_packet:
        src_ip: "140.82.112.3"
        dst_ip: "172.16.9.1"
        dst_port: 1024
