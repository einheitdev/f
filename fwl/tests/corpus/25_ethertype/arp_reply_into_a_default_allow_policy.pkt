name: "arp reply into a default allow policy"
source_fw: |
  @xdp(eth0)
  default allow
# EtherType 0x0806 is neither ETH_P_IP nor ETH_P_IPV6, so the no-fields prelude returns XDP_PASS BEFORE the policy's action runs — which is why even the `default allow` shape expects allow.
# This is the arm 1434 corpus cases never took, and stray non-IP frames are the normal traffic on the network this box is going into.
test_packet:
  builder: eth(ethertype=0x0806, payload_hex="00010800060400020200000000020a0000020200000000010a000001")
expected:
  compiles: true
  bpf_action: allow
