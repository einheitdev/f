name: "bare nat arp reply into the ipv4 helper"
source_fw: |
  @xdp(wan)
  masquerade
  allow
state:
  nat:
    masq_ip: "198.51.100.9"
# EtherType 0x0806 reaches `h_proto != bpf_htons(ETH_P_IP)` inside fwl_find_ipv4.
# NAT is IPv4-only by design; the frame is forwarded untranslated rather than mangled.
test_packet:
  builder: eth(ethertype=0x0806, payload_hex="00010800060400020200000000020a0000020200000000010a000001")
expected:
  compiles: true
  bpf_action: allow
