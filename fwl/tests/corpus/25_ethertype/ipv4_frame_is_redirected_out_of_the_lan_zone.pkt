name: "ipv4 frame is redirected out of the lan zone"
source_fw: |
  zone wan = [wan0]
  zone lan = [lan0]
  @xdp(lan)
  count lan_out
  masquerade
  redirect to wan
ingress_zone: lan
# The control arm. Without it, a program that redirected nothing at all would satisfy all five assertions above.
test_packet:
  builder: tcp(src_ip="192.168.2.7", dst_ip="8.8.8.8", dst_port=443)
expected:
  compiles: true
  bpf_action: redirect
  counter_changes:
    lan_out: 1
