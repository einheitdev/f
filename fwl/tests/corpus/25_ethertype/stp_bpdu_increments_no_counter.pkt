name: "stp bpdu increments no counter"
source_fw: |
  @xdp(eth0)
  count l2_noise
  default drop
# `count` is emitted after the prelude, so a frame that early-outs never reaches it. Asserting the counter — not just the action — is what distinguishes 'the early-out fired' from 'the policy happened to pass it'.
test_packet:
  builder: eth(ethertype=0x0026, payload_hex="4242030000000000800002000000000100000000800002000000000180010000140002000f00")
expected:
  compiles: true
  bpf_action: allow
  counter_changes:
    l2_noise: 0
