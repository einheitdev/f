name: "tagged arp reply vlan 100 into a default allow policy"
source_fw: |
  @xdp(eth0)
  default allow
# 802.1Q tag 100, then EtherType 0x0806. The prelude reads the tag and re-reads fwl_l3p from vh->inner_proto, so the non-IP test runs against the REAL type and not against 0x8100.
test_packet:
  builder: eth(ethertype=0x0806, payload_hex="00010800060400020200000000020a0000020200000000010a000001", vlan_id=100)
expected:
  compiles: true
  bpf_action: allow
