name: "tagged arp request vlan 1 into a default drop policy"
source_fw: |
  @xdp(eth0)
  default drop
# 802.1Q tag 1, then EtherType 0x0806. The prelude reads the tag and re-reads fwl_l3p from vh->inner_proto, so the non-IP test runs against the REAL type and not against 0x8100.
test_packet:
  builder: eth(ethertype=0x0806, payload_hex="00010800060400010200000000010a0000010000000000000a000002", vlan_id=1)
expected:
  compiles: true
  bpf_action: allow
