name: "tagged mpls multicast vlan 4094 into a unconditional drop policy"
source_fw: |
  @xdp(eth0)
  drop
# 802.1Q tag 4094, then EtherType 0x8848. The prelude reads the tag and re-reads fwl_l3p from vh->inner_proto, so the non-IP test runs against the REAL type and not against 0x8100.
test_packet:
  builder: eth(ethertype=0x8848, vlan_id=4094)
expected:
  compiles: true
  bpf_action: allow
