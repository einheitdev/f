name: "tagged stp bpdu vlan 1 into a default drop policy"
source_fw: |
  @xdp(eth0)
  default drop
# 802.1Q tag 1, then EtherType 0x0026. The prelude reads the tag and re-reads fwl_l3p from vh->inner_proto, so the non-IP test runs against the REAL type and not against 0x8100.
test_packet:
  builder: eth(ethertype=0x0026, payload_hex="4242030000000000800002000000000100000000800002000000000180010000140002000f00", vlan_id=1)
expected:
  compiles: true
  bpf_action: allow
