name: "unknown 0xffff into a unconditional drop policy"
source_fw: |
  @xdp(eth0)
  drop
# EtherType 0xffff is neither ETH_P_IP nor ETH_P_IPV6, so the no-fields prelude returns XDP_PASS BEFORE the policy's action runs — which is why even the `unconditional drop` shape expects allow.
# This is the arm 1434 corpus cases never took, and stray non-IP frames are the normal traffic on the network this box is going into.
test_packet:
  builder: eth(ethertype=0xffff)
expected:
  compiles: true
  bpf_action: allow
