# A client with no lease addresses its DISCOVER to 255.255.255.255,
# because it has neither an address of its own nor ours. Reaching the
# unconditional `masquerade` + `redirect to wan` below would source-NAT
# it to the gateway's wan address and broadcast it onto the corporate
# network, while this box's own dnsmasq never saw it (A3).
name: "lan: DHCP DISCOVER is delivered locally, not masqueraded"
source_fw: |
  zone wan = [wan0]
  zone lan = [lan0]
  @xdp(lan)
  allow if pkt.proto == udp and pkt.dst_port == 67
  allow if pkt.dst_ip == 10.99.82.1
  drop if pkt.dst_ip in 224.0.0.0/4
  drop if pkt.dst_ip == 255.255.255.255
  drop if pkt.dst_ip == 10.99.82.255
  masquerade
  redirect to wan
ingress_zone: lan
state:
  nat:
    masq_ip: "203.0.113.7"
test_packet:
  builder: udp(src_ip="0.0.0.0", dst_ip="255.255.255.255", src_port=68, dst_port=67)
expected:
  compiles: true
  bpf_action: allow
