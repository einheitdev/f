name: "dst ip6 high half: control, dst_ip6_hi == K decides true"
source_fw: |
  @xdp(eth0)
  drop if pkt.dst_ip6 == ::1
  default allow
# The control for the case above. Same policy, and the only difference is the field `dst_ip6_hi == K` reads — so it must produce the OPPOSITE action.
# Without this a program that matched nothing at all would satisfy the near-miss and the pair would be untestable.
test_packet:
  builder: tcp6(dst_ip="::1", dst_port=80)
expected:
  compiles: true
  bpf_action: drop
