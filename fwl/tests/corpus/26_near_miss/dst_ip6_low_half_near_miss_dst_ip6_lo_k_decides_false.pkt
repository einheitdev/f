name: "dst ip6 low half: near miss, dst_ip6_lo == K decides false"
source_fw: |
  @xdp(eth0)
  drop if pkt.dst_ip6 == ::1
  default allow
# Reaches the rule and fails ONLY on `dst_ip6_lo == K`. High half zero and matching, low half 2 against the expected 1 — the smallest possible difference in the half that is read second.
# That arm had never been taken by any corpus case: the corpus sends packets that match this rule, and packets that fail at the first conjunct and never evaluate this one.
test_packet:
  builder: tcp6(dst_ip="::2", dst_port=80)
expected:
  compiles: true
  bpf_action: allow
