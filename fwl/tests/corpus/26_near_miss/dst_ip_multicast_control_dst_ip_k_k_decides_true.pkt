name: "dst ip multicast: control, (dst_ip & K) == K decides true"
source_fw: |
  @xdp(eth0)
  drop if pkt.dst_ip in 224.0.0.0/4
  default allow
# The control for the case above. Same policy, and the only difference is the field `(dst_ip & K) == K` reads — so it must produce the OPPOSITE action.
# Without this a program that matched nothing at all would satisfy the near-miss and the pair would be untestable.
test_packet:
  builder: tcp(dst_ip="224.0.0.251", dst_port=80)
expected:
  compiles: true
  bpf_action: drop
