name: "dst ip multicast: near miss, (dst_ip & K) == K decides false"
source_fw: |
  @xdp(eth0)
  drop if pkt.dst_ip in 224.0.0.0/4
  default allow
# Reaches the rule and fails ONLY on `(dst_ip & K) == K`. One address below the multicast block — the boundary of the /4, where an emitter with the wrong mask width answers differently.
# That arm had never been taken by any corpus case: the corpus sends packets that match this rule, and packets that fail at the first conjunct and never evaluate this one.
test_packet:
  builder: tcp(dst_ip="223.255.255.255", dst_port=80)
expected:
  compiles: true
  bpf_action: allow
