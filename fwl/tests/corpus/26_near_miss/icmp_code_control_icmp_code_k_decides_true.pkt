name: "icmp code: control, icmp_code == K decides true"
source_fw: |
  @xdp(eth0)
  drop if pkt.proto == icmp and pkt.icmp.code == 0
  default allow
# The control for the case above. Same policy, and the only difference is the field `icmp_code == K` reads — so it must produce the OPPOSITE action.
# Without this a program that matched nothing at all would satisfy the near-miss and the pair would be untestable.
test_packet:
  builder: icmp(type=3, code=0)
expected:
  compiles: true
  bpf_action: drop
