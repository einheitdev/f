name: "port not in list: near miss, !(((l4_ok && (dst_port == K)) || (l4_ok && (dst_port == K)))) decides false"
source_fw: |
  @xdp(eth0)
  drop if pkt.proto == tcp and not (pkt.dst_port == 22 or pkt.dst_port == 80)
  default allow
# Reaches the rule and fails ONLY on `!(((l4_ok && (dst_port == K)) || (l4_ok && (dst_port == K))))`. A port that IS in the negated list, so the disjunction decides true and the negation false. Every case so far sent a port in neither.
# That arm had never been taken by any corpus case: the corpus sends packets that match this rule, and packets that fail at the first conjunct and never evaluate this one.
test_packet:
  builder: tcp(dst_port=22, syn=true)
expected:
  compiles: true
  bpf_action: allow
