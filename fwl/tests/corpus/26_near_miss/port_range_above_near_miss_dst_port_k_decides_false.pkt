name: "port range above: near miss, dst_port <= K decides false"
source_fw: |
  @xdp(eth0)
  drop if pkt.proto == tcp and pkt.dst_port in 5000..6000
  default allow
# Reaches the rule and fails ONLY on `dst_port <= K`. One port above the range. The lower comparison decides true and the upper one decides false — the first time it has decided anything but true.
# That arm had never been taken by any corpus case: the corpus sends packets that match this rule, and packets that fail at the first conjunct and never evaluate this one.
test_packet:
  builder: tcp(dst_port=6001, syn=true)
expected:
  compiles: true
  bpf_action: allow
