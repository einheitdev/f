name: "proto negated: control, proto != IPPROTO_TCP decides true"
source_fw: |
  @xdp(eth0)
  drop if pkt.proto != tcp
  default allow
# The control for the case above. Same policy, and the only difference is the field `proto != IPPROTO_TCP` reads — so it must produce the OPPOSITE action.
# Without this a program that matched nothing at all would satisfy the near-miss and the pair would be untestable.
test_packet:
  builder: udp(dst_port=53, src_port=51000)
expected:
  compiles: true
  bpf_action: drop
