name: "src ip6 high half: near miss, src_ip6_hi == K decides false"
source_fw: |
  @xdp(eth0)
  drop if pkt.src_ip6 == ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
  default allow
# Reaches the rule and fails ONLY on `src_ip6_hi == K`. The LOW 64 bits are all ones and match; the high 64 do not. The high comparison decides false for the first time in the 27 programs that contain it — and a program that compared the low half twice would pass every one of them.
# That arm had never been taken by any corpus case: the corpus sends packets that match this rule, and packets that fail at the first conjunct and never evaluate this one.
test_packet:
  builder: tcp6(src_ip="2001:db8::ffff:ffff:ffff:ffff", dst_port=80)
expected:
  compiles: true
  bpf_action: allow
