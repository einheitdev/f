name: "src ip6 low half: near miss, src_ip6_lo == K decides false"
source_fw: |
  @xdp(eth0)
  drop if pkt.src_ip6 == ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
  default allow
# Reaches the rule and fails ONLY on `src_ip6_lo == K`. The mirror image: the HIGH 64 bits match, so the first comparison decides true and the second is reached and decides false. Both directions are needed — either half alone is satisfied by an emitter that read the same word twice.
# That arm had never been taken by any corpus case: the corpus sends packets that match this rule, and packets that fail at the first conjunct and never evaluate this one.
test_packet:
  builder: tcp6(src_ip="ffff:ffff:ffff:ffff::1", dst_port=80)
expected:
  compiles: true
  bpf_action: allow
