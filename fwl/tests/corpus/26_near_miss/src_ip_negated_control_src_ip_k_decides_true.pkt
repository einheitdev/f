name: "src ip negated: control, src_ip != K decides true"
source_fw: |
  @xdp(eth0)
  drop if pkt.src_ip != 8.8.8.8
  default allow
# The control for the case above. Same policy, and the only difference is the field `src_ip != K` reads — so it must produce the OPPOSITE action.
# Without this a program that matched nothing at all would satisfy the near-miss and the pair would be untestable.
test_packet:
  builder: tcp(src_ip="1.1.1.1", dst_port=80)
expected:
  compiles: true
  bpf_action: drop
