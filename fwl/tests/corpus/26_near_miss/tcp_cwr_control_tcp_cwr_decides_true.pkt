name: "tcp cwr: control, tcp_cwr decides true"
source_fw: |
  @xdp(eth0)
  drop if pkt.proto == tcp and pkt.tcp.cwr
  default allow
# The control for the case above. Same policy, and the only difference is the field `tcp_cwr` reads — so it must produce the OPPOSITE action.
# Without this a program that matched nothing at all would satisfy the near-miss and the pair would be untestable.
test_packet:
  builder: tcp(cwr=true, dst_port=80)
expected:
  compiles: true
  bpf_action: drop
