name: "tcp psh: control, tcp_psh decides true"
source_fw: |
  @xdp(eth0)
  drop if pkt.proto == tcp and pkt.tcp.psh
  default allow
# The control for the case above. Same policy, and the only difference is the field `tcp_psh` reads — so it must produce the OPPOSITE action.
# Without this a program that matched nothing at all would satisfy the near-miss and the pair would be untestable.
test_packet:
  builder: tcp(psh=true, dst_port=80)
expected:
  compiles: true
  bpf_action: drop
