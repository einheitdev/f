name: "vlan id range below: near miss, vlan_id >= K decides false"
source_fw: |
  @xdp(eth0)
  drop if pkt.vlan_id in 100..199
  default allow
# Reaches the rule and fails ONLY on `vlan_id >= K`. One VLAN below the range, short-circuiting before the upper bound is read.
# That arm had never been taken by any corpus case: the corpus sends packets that match this rule, and packets that fail at the first conjunct and never evaluate this one.
test_packet:
  builder: tcp(vlan_id=99, dst_port=80)
expected:
  compiles: true
  bpf_action: allow
