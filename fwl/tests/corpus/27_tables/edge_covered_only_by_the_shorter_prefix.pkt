name: "the shorter prefix alone still matches"
# The other half of the pair: same table, an address the /8 covers and
# the /32 does not.
source_fw: |
  table badhosts {
    kind = cidr4
    max = 1000
    source = "badhosts.txt"
  }

  @xdp(eth0)
  drop if pkt.src_ip in badhosts
  default allow

table_data:
  badhosts: ["10.0.0.0/8", "10.1.2.3/32"]

test_packet:
  builder: tcp(src_ip="10.9.9.9", dst_port=80)

expected:
  compiles: true
  bpf_action: drop
