name: "a table with no contents matches nothing"
# The vacuity anchor for this whole directory. Every passing case above
# seeds the table; without this one they would all pass just as well on
# a program that dropped unconditionally.
source_fw: |
  table badhosts {
    kind = cidr4
    max = 1000
    source = "/var/lib/f/feeds/badhosts.txt"
  }

  @xdp(eth0)
  drop if pkt.src_ip in badhosts
  default allow

# (no table_data: block -- the trie loads empty)

test_packet:
  builder: tcp(src_ip="5.8.1.1", dst_port=80)

expected:
  compiles: true
  bpf_action: allow
