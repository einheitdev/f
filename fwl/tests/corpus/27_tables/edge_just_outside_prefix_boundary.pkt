name: "the first address past a /24 does not match"
source_fw: |
  table badhosts {
    kind = cidr4
    max = 1000
    source = "/var/lib/f/feeds/badhosts.txt"
  }

  @xdp(eth0)
  drop if pkt.src_ip in badhosts
  default allow

table_data:
  badhosts: ["192.0.2.0/24"]

test_packet:
  builder: tcp(src_ip="192.0.3.0", dst_port=80)

expected:
  compiles: true
  bpf_action: allow
