name: "::/0 in a cidr6 table covers every v6 address"
source_fw: |
  table badhosts6 {
    kind = cidr6
    max = 1000
    source = "badhosts6.txt"
  }

  @xdp(eth0)
  drop if pkt.src_ip6 in badhosts6
  default allow

table_data:
  badhosts6: ["::/0"]

test_packet:
  builder: tcp6(src_ip="2001:db8::99", dst_port=22)

expected:
  compiles: true
  bpf_action: drop
