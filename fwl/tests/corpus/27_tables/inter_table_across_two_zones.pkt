name: "two zones matching one table mean one set"
# The table is SHARED, so both zone objects declare the same pinned
# name. This case exercises the lan zone; the wan rule is what makes
# the map bundle-global rather than per-zone.
source_fw: |
  table badhosts {
    kind = cidr4
    max = 1000
    source = "/var/lib/f/feeds/badhosts.txt"
  }

  zone wan = [eth0]
  zone lan = [eth1]

  @xdp(wan)
  drop if pkt.src_ip in badhosts
  default allow

  @xdp(lan)
  drop if pkt.dst_ip in badhosts
  default allow

ingress_zone: lan

table_data:
  badhosts: ["5.8.0.0/16"]

test_packet:
  builder: tcp(src_ip="10.0.0.5", dst_ip="5.8.1.1", dst_port=80)

expected:
  compiles: true
  bpf_action: drop
