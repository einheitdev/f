name: "a table and a geoip() call in one program keep separate tries"
# The two mechanisms compile to the same map type. Their maps must
# still be distinct, or a named table would answer a country's rule.
source_fw: |
  table badhosts {
    kind = cidr4
    max = 1000
    source = "/var/lib/f/feeds/badhosts.txt"
  }

  @xdp(eth0)
  drop if pkt.src_ip in badhosts
  drop if pkt.src_ip in geoip(RU)
  default allow

table_data:
  badhosts: ["5.8.0.0/16"]

geoip_data:
  RU: ["91.0.0.0/8"]

test_packet:
  builder: tcp(src_ip="91.1.2.3", dst_port=80)

expected:
  compiles: true
  bpf_action: drop
