name: "a table lookup is one arm of an or"
source_fw: |
  table badhosts {
    kind = cidr4
    max = 1000
    source = "/var/lib/f/feeds/badhosts.txt"
  }

  @xdp(eth0)
  drop if pkt.src_ip in badhosts or pkt.dst_ip == 10.0.0.1
  default allow

table_data:
  badhosts: ["5.8.0.0/16"]

test_packet:
  builder: tcp(src_ip="9.9.9.9", dst_ip="10.0.0.1", dst_port=80)

expected:
  compiles: true
  bpf_action: drop
