name: "the same Tier 2 v6 local allows an address the table lacks"
source_fw: |
  table badhosts6 {
    kind = cidr6
    max = 1000
    source = "/var/lib/f/feeds/badhosts6.txt"
  }

  @xdp(eth0)
  def firewall(pkt):
    if pkt.src_ip6 in ::/0:
      who = pkt.src_ip6
      if who in badhosts6:
        drop
    allow

table_data:
  badhosts6: ["2a00:1370::/32"]

test_packet:
  builder: tcp6(src_ip="2a00:1371::1", dst_port=80)

expected:
  compiles: true
  bpf_action: allow
