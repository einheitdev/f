name: "a counted non-terminal rule matches on a table"
source_fw: |
  table badhosts {
    kind = cidr4
    max = 1000
    source = "badhosts.txt"
  }

  @xdp(eth0)
  count blocked_hits if pkt.src_ip in badhosts
  drop if pkt.src_ip in badhosts
  default allow

table_data:
  badhosts: ["5.8.0.0/16"]

test_packet:
  builder: tcp(src_ip="5.8.1.1", dst_port=80)

expected:
  compiles: true
  bpf_action: drop
  counter_changes:
    blocked_hits: 1
