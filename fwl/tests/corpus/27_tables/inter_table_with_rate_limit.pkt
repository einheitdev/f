name: "a table rule fires only once its rate_limit bucket is at threshold"
# `limited by` gates the rule on the bucket, so the same packet and the
# same table give a different verdict either side of the threshold.
# This is the at-threshold half.
source_fw: |
  table badhosts {
    kind = cidr4
    max = 1000
    source = "badhosts.txt"
  }

  @xdp(eth0)
  drop if pkt.src_ip in badhosts
       limited by rate_limit(5, per=src_ip)
  default allow

table_data:
  badhosts: ["5.8.0.0/16"]

state:
  rate_limit:
    0:
      "5.8.1.1": 5

test_packet:
  builder: tcp(src_ip="5.8.1.1", dst_port=80)

expected:
  compiles: true
  bpf_action: drop
