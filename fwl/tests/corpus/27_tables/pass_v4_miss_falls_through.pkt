name: "src_ip outside every prefix falls through to default"
# The near-miss half of the pair above. A positive-only corpus cannot
# tell a working lookup from an always-true one -- 26_near_miss exists
# for exactly this -- so every hit case here has a miss beside it.
source_fw: |
  table badhosts {
    kind = cidr4
    max = 1000
    source = "badhosts.txt"
  }

  @xdp(eth0)
  drop if pkt.src_ip in badhosts
  default allow

table_data:
  badhosts: ["5.8.0.0/16"]

test_packet:
  builder: tcp(src_ip="5.9.1.1", dst_port=80)

expected:
  compiles: true
  bpf_action: allow
