name: "a and not (b or c): tcp from external src triggers drop"
source_fw: |
  @xdp(eth0)
  drop if pkt.proto == tcp and not (pkt.src_ip in 10.0.0.0/8 or pkt.src_ip in 192.168.0.0/16)
  default allow

test_packet:
  builder: tcp(src_ip="8.8.8.8", dst_port=80)

expected:
  compiles: true
  bpf_action: drop
