name: "deep nesting (3+ levels of parens): inner port set fails -> drop"
source_fw: |
  @xdp(eth0)
  allow if ((pkt.proto == tcp and (pkt.dst_port == 22 or pkt.dst_port == 80)) or (pkt.proto == udp and pkt.dst_port == 53))
  default drop

test_packet:
  builder: tcp(dst_port=443)

expected:
  compiles: true
  bpf_action: drop
