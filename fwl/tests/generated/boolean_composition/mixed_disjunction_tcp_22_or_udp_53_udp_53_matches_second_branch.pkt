name: "mixed disjunction tcp/22 or udp/53 - udp/53 matches second branch"
source_fw: |
  @xdp(eth0)
  allow if (pkt.proto == tcp and pkt.dst_port == 22) or (pkt.proto == udp and pkt.dst_port == 53)
  default drop

test_packet:
  builder: udp(src_ip="4.4.4.4", dst_port=53)

expected:
  compiles: true
  bpf_action: allow
