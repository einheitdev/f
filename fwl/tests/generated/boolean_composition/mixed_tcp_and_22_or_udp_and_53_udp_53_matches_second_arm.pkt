name: "mixed '(tcp and 22) or (udp and 53)': udp/53 matches second arm"
source_fw: |
  @xdp(eth0)
  allow if (pkt.proto == tcp and pkt.dst_port == 22) or (pkt.proto == udp and pkt.dst_port == 53)
  default drop

test_packet:
  builder: udp(dst_port=53)

expected:
  compiles: true
  bpf_action: allow
