name: "parens override: '(a or b) and c' fails when c false (would have allowed without parens)"
source_fw: |
  @xdp(eth0)
  allow if (pkt.proto == tcp or pkt.proto == udp) and pkt.src_ip == 9.9.9.9
  default drop

test_packet:
  builder: tcp(src_ip="1.2.3.4", dst_port=80)

expected:
  compiles: true
  bpf_action: drop
