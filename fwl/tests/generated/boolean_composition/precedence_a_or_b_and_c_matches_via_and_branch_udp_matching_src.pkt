name: "precedence: 'a or b and c' matches via and-branch (udp + matching src)"
source_fw: |
  @xdp(eth0)
  allow if pkt.proto == tcp or pkt.proto == udp and pkt.src_ip == 9.9.9.9
  default drop

test_packet:
  builder: udp(src_ip="9.9.9.9", dst_port=53)

expected:
  compiles: true
  bpf_action: allow
