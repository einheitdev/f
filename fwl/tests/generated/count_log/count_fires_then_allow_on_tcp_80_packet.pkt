name: "count fires then allow on tcp/80 packet"
source_fw: |
  @xdp(eth0)
  count http_traffic if pkt.proto == tcp and pkt.dst_port == 80
  allow if pkt.proto == tcp and pkt.dst_port == 80
  default drop

test_packet:
  builder: tcp(src_ip="10.0.0.5", dst_port=80)

expected:
  compiles: true
  bpf_action: allow
