name: "count rule with non-matching condition falls through to allow"
source_fw: |
  @xdp(eth0)
  count https_traffic if pkt.proto == tcp and pkt.dst_port == 443
  allow if pkt.proto == tcp
  default drop

test_packet:
  builder: tcp(src_ip="10.0.0.9", dst_port=80)

expected:
  compiles: true
  bpf_action: allow
