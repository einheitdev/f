name: "count with proto guard and dst_port match before allow"
source_fw: |
  @xdp(eth0)
  count ssh_attempts if pkt.proto == tcp and pkt.dst_port == 22
  allow if pkt.proto == tcp and pkt.dst_port == 22
  default drop

test_packet:
  builder: tcp(dst_port=22, syn=true)

expected:
  compiles: true
  bpf_action: allow
