name: "log then count then count then terminal allow chain"
source_fw: |
  @xdp(eth0)
  log if pkt.proto == tcp
  count tcp_packets if pkt.proto == tcp
  count web_packets if pkt.proto == tcp and pkt.dst_port in [80, 443, 8080]
  allow if pkt.proto == tcp
  default drop

test_packet:
  builder: tcp(dst_port=8080)

expected:
  compiles: true
  bpf_action: allow
