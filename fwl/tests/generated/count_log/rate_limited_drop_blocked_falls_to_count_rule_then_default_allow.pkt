name: "rate-limited drop blocked, falls to count rule, then default allow"
source_fw: |
  @xdp(eth0)
  drop if pkt.proto == tcp limited by rate_limit(5, per=src_ip)
  count overflow if pkt.proto == tcp
  default allow

test_packet:
  builder: tcp(src_ip="5.5.5.5", dst_port=80)

state:
  rate_limit:
    0:
      "5.5.5.5": 5

expected:
  compiles: true
  bpf_action: allow
