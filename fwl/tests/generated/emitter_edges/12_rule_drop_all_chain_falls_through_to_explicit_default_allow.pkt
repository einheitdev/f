name: "12-rule drop-all chain falls through to explicit default allow"
source_fw: |
  @xdp(eth0)
  drop if pkt.src_ip == 1.1.1.1
  drop if pkt.src_ip == 2.2.2.2
  drop if pkt.src_ip == 3.3.3.3
  drop if pkt.src_ip == 4.4.4.4
  drop if pkt.src_ip == 5.5.5.5
  drop if pkt.src_ip == 6.6.6.6
  drop if pkt.src_ip == 7.7.7.7
  drop if pkt.src_ip == 8.8.8.8
  drop if pkt.src_ip == 9.9.9.9
  drop if pkt.src_ip == 10.10.10.10
  drop if pkt.src_ip == 11.11.11.11
  drop if pkt.src_ip == 12.12.12.12
  default allow

test_packet:
  builder: tcp(src_ip="99.99.99.99", dst_port=80)

expected:
  compiles: true
  bpf_action: allow
