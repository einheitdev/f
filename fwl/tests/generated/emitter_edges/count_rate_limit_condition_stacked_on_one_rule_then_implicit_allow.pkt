name: "count + rate_limit + condition stacked on one rule, then implicit allow"
source_fw: |
  @xdp(eth0)
  count blocked if pkt.proto == tcp and pkt.dst_port == 22 and pkt.tcp.syn
         limited by rate_limit(100, per=src_ip)
  allow

test_packet:
  builder: tcp(src_ip="1.2.3.4", dst_port=22, syn=true)

expected:
  compiles: true
  bpf_action: allow
