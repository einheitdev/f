name: "log + rate_limit + condition stacked on one rule, then implicit allow"
source_fw: |
  @xdp(eth0)
  log if pkt.proto == tcp and pkt.tcp.syn
         limited by rate_limit(50, per=src_ip)
  allow

test_packet:
  builder: tcp(src_ip="7.7.7.7", dst_port=22, syn=true)

expected:
  compiles: true
  bpf_action: allow
