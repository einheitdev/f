name: "rate_limit per=dst_ip — bucket below threshold, drop fires"
source_fw: |
  @xdp(eth0)
  drop if pkt.proto == tcp and pkt.dst_port == 80
         limited by rate_limit(100, per=dst_ip)
  default allow

state:
  rate_limit:
    0:
      "5.6.7.8": 50

test_packet:
  builder: tcp(src_ip="1.1.1.1", dst_ip="5.6.7.8", dst_port=80)

expected:
  compiles: true
  bpf_action: drop
