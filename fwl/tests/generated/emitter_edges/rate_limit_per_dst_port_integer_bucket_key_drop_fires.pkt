name: "rate_limit per=dst_port — integer bucket key, drop fires"
source_fw: |
  @xdp(eth0)
  drop if pkt.proto == tcp
         limited by rate_limit(50, per=dst_port)
  default allow

state:
  rate_limit:
    0:
      80: 30

test_packet:
  builder: tcp(dst_port=80)

expected:
  compiles: true
  bpf_action: drop
