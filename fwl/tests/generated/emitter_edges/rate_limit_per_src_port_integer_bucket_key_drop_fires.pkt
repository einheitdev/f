name: "rate_limit per=src_port — integer bucket key, drop fires"
source_fw: |
  @xdp(eth0)
  drop if pkt.proto == udp and pkt.dst_port == 53
         limited by rate_limit(20, per=src_port)
  default allow

state:
  rate_limit:
    0:
      12345: 10

test_packet:
  builder: udp(src_port=12345, dst_port=53)

expected:
  compiles: true
  bpf_action: drop
