name: "OR-precedence: tcp or (udp and dst_port == 443) is well-formed per the constraint-set rule"
source_fw: |
  @xdp(eth0)
  allow if pkt.proto == tcp or pkt.proto == udp and pkt.dst_port == 443
  default drop

test_packet:
  builder: tcp(dst_port=80)

expected:
  compiles: true
  bpf_action: allow
