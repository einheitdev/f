name: "two OR branches each carrying their own proto guard compile and match per branch"
source_fw: |
  @xdp(eth0)
  allow if (pkt.proto == tcp and pkt.dst_port == 22)
        or (pkt.proto == udp and pkt.dst_port == 53)
  default drop

test_packet:
  builder: udp(dst_port=53)

expected:
  compiles: true
  bpf_action: allow
