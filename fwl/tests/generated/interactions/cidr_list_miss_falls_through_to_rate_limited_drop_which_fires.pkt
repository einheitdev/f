name: "cidr_list_miss_falls_through_to_rate_limited_drop_which_fires"
source_fw: |
  @xdp(eth0)
  allow if pkt.src_ip in [10.0.0.0/8, 192.168.0.0/16, 172.16.0.0/12]
  drop if pkt.proto == tcp and pkt.tcp.syn
         limited by rate_limit(5, per=src_ip)
  default allow

state:
  rate_limit:
    1:
      "8.8.8.8": 0

test_packet:
  builder: tcp(src_ip="8.8.8.8", dst_port=80, syn=true)

expected:
  compiles: true
  bpf_action: drop
