name: "cidr_match_with_port_range_and_proto_guard_outside_source_dropped"
source_fw: |
  @xdp(eth0)
  allow if pkt.src_ip in 10.0.0.0/8
         and pkt.proto == tcp
         and pkt.dst_port in 8000..8999
  default drop

test_packet:
  builder: tcp(src_ip="172.16.5.5", dst_port=8080)

expected:
  compiles: true
  bpf_action: drop
