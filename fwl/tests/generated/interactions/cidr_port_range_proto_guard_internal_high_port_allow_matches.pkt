name: "CIDR + port range + proto guard: internal high-port allow matches"
source_fw: |
  @xdp(eth0)
  allow if pkt.src_ip in 10.0.0.0/8
         and pkt.proto == tcp
         and pkt.dst_port in 1024..65535
  default drop

test_packet:
  builder: tcp(src_ip="10.5.5.5", dst_port=8080)

expected:
  compiles: true
  bpf_action: allow
