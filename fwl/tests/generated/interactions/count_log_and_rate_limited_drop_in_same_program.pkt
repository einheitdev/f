name: "count_log_and_rate_limited_drop_in_same_program"
source_fw: |
  @xdp(eth0)
  count ssh_attempts if pkt.proto == tcp and pkt.dst_port == 22
  log if pkt.proto == tcp and pkt.dst_port == 22 and pkt.tcp.syn
  drop if pkt.proto == tcp and pkt.dst_port == 22
         and pkt.tcp.syn and not pkt.tcp.ack
         limited by rate_limit(5, per=src_ip)
  allow if pkt.proto == tcp and pkt.dst_port == 22
  default drop

state:
  rate_limit:
    2:
      "10.20.30.40": 2

test_packet:
  builder: tcp(src_ip="10.20.30.40", dst_port=22, syn=true, ack=false)

expected:
  compiles: true
  bpf_action: drop
