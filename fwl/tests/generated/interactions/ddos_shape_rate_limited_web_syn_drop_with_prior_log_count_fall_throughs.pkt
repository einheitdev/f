name: "ddos shape: rate-limited web SYN drop with prior log+count fall-throughs"
source_fw: |
  @xdp(eth0)
  drop if pkt.proto == tcp
         and pkt.tcp.syn and not pkt.tcp.ack
         and pkt.dst_port in [80, 443]
         limited by rate_limit(100, per=src_ip)
  log if pkt.proto == tcp and pkt.tcp.syn
  count web_syn if pkt.proto == tcp and pkt.tcp.syn
                   and pkt.dst_port in [80, 443]
  allow if pkt.proto == tcp and pkt.dst_port in [80, 443]
  default drop

state:
  rate_limit:
    0:
      "9.9.9.9": 50

test_packet:
  builder: tcp(src_ip="9.9.9.9", dst_port=443, syn=true, ack=false)

expected:
  compiles: true
  bpf_action: drop
