name: "five-rule mix: log+count fire, then drop matches internal SSH attempt"
source_fw: |
  @xdp(eth0)
  log if pkt.proto == tcp and pkt.tcp.syn
  count blocked_ssh if pkt.proto == tcp and pkt.dst_port == 22
                       and pkt.src_ip in 10.0.0.0/8
  drop if pkt.proto == tcp and pkt.dst_port == 22
         and pkt.src_ip in 10.0.0.0/8
  allow if pkt.proto == tcp and pkt.dst_port in [80, 443]
  allow if pkt.proto == udp and pkt.dst_port == 53
  default drop

test_packet:
  builder: tcp(src_ip="10.0.0.5", dst_port=22, syn=true)

expected:
  compiles: true
  bpf_action: drop
