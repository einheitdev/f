name: "not(CIDR or CIDR) gated by rate_limit drops external src"
source_fw: |
  @xdp(eth0)
  drop if not (pkt.src_ip in 10.0.0.0/8
              or pkt.src_ip in 192.168.0.0/16)
         limited by rate_limit(50, per=src_ip)
  allow

test_packet:
  builder: tcp(src_ip="8.8.8.8", dst_port=80)

expected:
  compiles: true
  bpf_action: drop
