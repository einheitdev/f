name: "not(CIDR or CIDR) is false for internal src; rule skipped, final allow"
source_fw: |
  @xdp(eth0)
  drop if not (pkt.src_ip in 10.0.0.0/8
              or pkt.src_ip in 192.168.0.0/16)
         limited by rate_limit(50, per=src_ip)
  allow

test_packet:
  builder: tcp(src_ip="10.5.5.5", dst_port=80)

expected:
  compiles: true
  bpf_action: allow
