name: "rate_limit on allow with default drop: under threshold the allow fires"
source_fw: |
  @xdp(eth0)
  allow if pkt.proto == tcp and pkt.dst_port == 80
         limited by rate_limit(1000, per=src_ip)
  default drop

test_packet:
  builder: tcp(src_ip="7.7.7.7", dst_port=80)

expected:
  compiles: true
  bpf_action: allow
