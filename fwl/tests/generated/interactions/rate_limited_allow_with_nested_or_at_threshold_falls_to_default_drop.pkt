name: "rate_limited_allow_with_nested_or_at_threshold_falls_to_default_drop"
source_fw: |
  @xdp(eth0)
  allow if pkt.proto == tcp
         and (pkt.dst_port == 80 or pkt.dst_port == 443)
         limited by rate_limit(100, per=src_ip)
  default drop

state:
  rate_limit:
    0:
      "1.2.3.4": 100

test_packet:
  builder: tcp(src_ip="1.2.3.4", dst_port=443)

expected:
  compiles: true
  bpf_action: drop
