name: "ssh brute-force program: HTTPS hits the web-allow rule"
source_fw: |
  @xdp(eth0)
  drop if pkt.proto == tcp and pkt.dst_port == 22
         and pkt.tcp.syn and not pkt.tcp.ack
         limited by rate_limit(3, per=src_ip)
  allow if pkt.proto == tcp and pkt.dst_port == 22
  allow if pkt.proto == tcp and pkt.dst_port in [80, 443]
  allow if pkt.proto == udp and pkt.dst_port == 53
  default drop

test_packet:
  builder: tcp(src_ip="8.8.8.8", dst_port=443)

expected:
  compiles: true
  bpf_action: allow
