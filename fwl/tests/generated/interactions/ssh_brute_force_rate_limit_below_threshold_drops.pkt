name: "ssh_brute_force_rate_limit_below_threshold_drops"
source_fw: |
  @xdp(eth0)
  drop if pkt.proto == tcp
         and pkt.dst_port == 22
         and pkt.tcp.syn and not pkt.tcp.ack
         limited by rate_limit(10, per=src_ip)
  allow if pkt.proto == tcp and pkt.dst_port == 22
  default drop

state:
  rate_limit:
    0:
      "203.0.113.15": 3

test_packet:
  builder: tcp(src_ip="203.0.113.15", dst_port=22, syn=true, ack=false)

expected:
  compiles: true
  bpf_action: drop
