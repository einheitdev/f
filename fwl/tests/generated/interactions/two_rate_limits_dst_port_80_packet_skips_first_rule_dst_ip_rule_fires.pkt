name: "two rate_limits: dst_port=80 packet skips first rule, dst_ip rule fires"
source_fw: |
  @xdp(eth0)
  drop if pkt.proto == tcp and pkt.dst_port == 22
         limited by rate_limit(10, per=src_ip)
  drop if pkt.proto == tcp and pkt.dst_port == 80
         limited by rate_limit(100, per=dst_ip)
  default allow

test_packet:
  builder: tcp(src_ip="3.3.3.3", dst_ip="4.4.4.4", dst_port=80)

expected:
  compiles: true
  bpf_action: drop
