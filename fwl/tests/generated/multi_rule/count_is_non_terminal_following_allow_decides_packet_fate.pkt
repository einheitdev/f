name: "count is non-terminal; following allow decides packet fate"
source_fw: |
  @xdp(eth0)
  count http_traffic if pkt.proto == tcp and pkt.dst_port == 80
  allow if pkt.proto == tcp and pkt.dst_port == 80
  default drop

test_packet:
  builder: tcp(src_ip="3.3.3.3", dst_port=80)

expected:
  compiles: true
  bpf_action: allow
