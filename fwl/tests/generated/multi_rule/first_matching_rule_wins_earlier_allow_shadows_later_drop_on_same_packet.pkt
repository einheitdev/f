name: "first matching rule wins; earlier allow shadows later drop on same packet"
source_fw: |
  @xdp(eth0)
  allow if pkt.proto == tcp and pkt.dst_port == 80
  drop if pkt.proto == tcp and pkt.dst_port == 80

test_packet:
  builder: tcp(src_ip="1.2.3.4", dst_port=80)

expected:
  compiles: true
  bpf_action: allow
