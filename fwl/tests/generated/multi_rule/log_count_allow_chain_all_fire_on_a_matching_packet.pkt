name: "log + count + allow chain all fire on a matching packet"
source_fw: |
  @xdp(eth0)
  log if pkt.proto == tcp and pkt.dst_port == 443
  count https_seen if pkt.proto == tcp and pkt.dst_port == 443
  allow if pkt.proto == tcp and pkt.dst_port == 443
  default drop

test_packet:
  builder: tcp(dst_port=443)

expected:
  compiles: true
  bpf_action: allow
