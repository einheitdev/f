name: "log is non-terminal; subsequent drop on matching packet still fires"
source_fw: |
  @xdp(eth0)
  log if pkt.proto == tcp and pkt.tcp.syn
  drop if pkt.proto == tcp and pkt.dst_port == 22

test_packet:
  builder: tcp(src_ip="9.9.9.9", dst_port=22, syn=true)

expected:
  compiles: true
  bpf_action: drop
