name: "multiple counts before terminal allow all fire and packet passes"
source_fw: |
  @xdp(eth0)
  count tcp_total if pkt.proto == tcp
  count web_traffic if pkt.proto == tcp and pkt.dst_port == 443
  count tls_traffic if pkt.proto == tcp and pkt.dst_port == 443
  allow if pkt.proto == tcp and pkt.dst_port == 443
  default drop

test_packet:
  builder: tcp(dst_port=443)

expected:
  compiles: true
  bpf_action: allow
