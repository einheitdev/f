name: "tcp rule followed by udp rule: tcp packet matches first rule"
source_fw: |
  @xdp(eth0)
  allow if pkt.proto == tcp and pkt.dst_port == 80
  drop if pkt.proto == udp and pkt.dst_port == 53
  default drop

test_packet:
  builder: tcp(dst_port=80)

expected:
  compiles: true
  bpf_action: allow
