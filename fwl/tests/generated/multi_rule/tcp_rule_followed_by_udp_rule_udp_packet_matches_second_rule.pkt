name: "tcp rule followed by udp rule: udp packet matches second rule"
source_fw: |
  @xdp(eth0)
  allow if pkt.proto == tcp and pkt.dst_port == 80
  drop if pkt.proto == udp and pkt.dst_port == 53
  default allow

test_packet:
  builder: udp(dst_port=53)

expected:
  compiles: true
  bpf_action: drop
