name: "tcp rule skipped on udp packet; following udp rule matches and allows"
source_fw: |
  @xdp(eth0)
  drop if pkt.proto == tcp and pkt.dst_port == 22
  allow if pkt.proto == udp and pkt.dst_port == 53
  default drop

test_packet:
  builder: udp(src_ip="8.8.8.8", dst_port=53)

expected:
  compiles: true
  bpf_action: allow
