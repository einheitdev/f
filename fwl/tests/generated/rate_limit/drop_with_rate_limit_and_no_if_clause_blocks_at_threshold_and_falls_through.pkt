name: "drop with rate_limit and no if clause blocks at threshold and falls through"
source_fw: |
  @xdp(eth0)
  drop limited by rate_limit(100, per=src_ip)
  default allow

state:
  rate_limit:
    0:
      "8.8.8.8": 100

test_packet:
  builder: tcp(src_ip="8.8.8.8", dst_port=80)

expected:
  compiles: true
  bpf_action: allow
