name: "first rate_limit rule fires terminally so second rate_limit is unused"
source_fw: |
  @xdp(eth0)
  drop if pkt.proto == tcp and pkt.dst_port == 22
       limited by rate_limit(5, per=src_ip)
  drop if pkt.proto == tcp
       limited by rate_limit(1, per=dst_ip)
  default allow

state:
  rate_limit:
    1:
      "9.9.9.9": 5

test_packet:
  builder: tcp(src_ip="1.2.3.4", dst_ip="9.9.9.9", dst_port=22)

expected:
  compiles: true
  bpf_action: drop
