name: "rate_limit buckets are independent across src_ip values"
source_fw: |
  @xdp(eth0)
  drop if pkt.proto == tcp and pkt.dst_port == 22
       limited by rate_limit(3, per=src_ip)
  default allow

state:
  rate_limit:
    0:
      "1.1.1.1": 3
      "2.2.2.2": 0

test_packet:
  builder: tcp(src_ip="2.2.2.2", dst_port=22)

expected:
  compiles: true
  bpf_action: drop
