name: "rate_limit gate is not consulted when if condition is false"
source_fw: |
  @xdp(eth0)
  drop if pkt.proto == tcp and pkt.dst_port == 22
       limited by rate_limit(5, per=src_ip)
  default allow

state:
  rate_limit:
    0:
      "1.2.3.4": 9999

test_packet:
  builder: tcp(src_ip="1.2.3.4", dst_port=80)

expected:
  compiles: true
  bpf_action: allow
