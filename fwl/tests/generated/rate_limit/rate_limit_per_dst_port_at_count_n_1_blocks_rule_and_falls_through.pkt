name: "rate_limit per=dst_port at count N+1 blocks rule and falls through"
source_fw: |
  @xdp(eth0)
  drop if pkt.proto == tcp and pkt.dst_port == 443
       limited by rate_limit(20, per=dst_port)
  allow if pkt.proto == tcp and pkt.dst_port == 443
  default drop

state:
  rate_limit:
    0:
      443: 21

test_packet:
  builder: tcp(dst_port=443)

expected:
  compiles: true
  bpf_action: allow
