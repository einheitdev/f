name: "rate_limit per=src_port at count==N blocks rule"
source_fw: |
  @xdp(eth0)
  drop if pkt.proto == tcp
       limited by rate_limit(3, per=src_port)
  default allow

state:
  rate_limit:
    0:
      44444: 3

test_packet:
  builder: tcp(src_port=44444, dst_port=80)

expected:
  compiles: true
  bpf_action: allow
