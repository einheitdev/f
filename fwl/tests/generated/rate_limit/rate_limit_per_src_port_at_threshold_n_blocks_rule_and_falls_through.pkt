name: "rate_limit per=src_port at threshold N blocks rule and falls through"
source_fw: |
  @xdp(eth0)
  drop if pkt.proto == tcp and pkt.dst_port == 80
       limited by rate_limit(100, per=src_port)
  allow if pkt.proto == tcp and pkt.dst_port == 80
  default drop

state:
  rate_limit:
    0:
      55555: 100

test_packet:
  builder: tcp(src_port=55555, dst_port=80)

expected:
  compiles: true
  bpf_action: allow
