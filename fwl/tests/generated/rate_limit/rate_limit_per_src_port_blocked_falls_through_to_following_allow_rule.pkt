name: "rate_limit per=src_port blocked falls through to following allow rule"
source_fw: |
  @xdp(eth0)
  drop if pkt.proto == tcp
       limited by rate_limit(2, per=src_port)
  allow if pkt.proto == tcp
  default drop

state:
  rate_limit:
    0:
      55555: 2

test_packet:
  builder: tcp(src_port=55555, dst_port=80)

expected:
  compiles: true
  bpf_action: allow
