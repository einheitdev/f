name: "second rate_limit rule fires drop after first rate_limit rule blocks"
source_fw: |
  @xdp(eth0)
  drop if pkt.proto == tcp and pkt.dst_port == 22
       limited by rate_limit(2, per=src_ip)
  drop if pkt.proto == tcp
       limited by rate_limit(100, per=dst_ip)
  default allow

state:
  rate_limit:
    0:
      "1.2.3.4": 2

test_packet:
  builder: tcp(src_ip="1.2.3.4", dst_ip="9.9.9.9", dst_port=22)

expected:
  compiles: true
  bpf_action: drop
