name: "ssh syn rate_limit at threshold falls through to allow"
source_fw: |
  @xdp(eth0)
  drop if pkt.proto == tcp and pkt.dst_port == 22
       and pkt.tcp.syn and not pkt.tcp.ack
       limited by rate_limit(10, per=src_ip)
  allow if pkt.proto == tcp and pkt.dst_port == 22
  default drop

state:
  rate_limit:
    0:
      "1.2.3.4": 10

test_packet:
  builder: tcp(src_ip="1.2.3.4", dst_port=22, syn=true)

expected:
  compiles: true
  bpf_action: allow
