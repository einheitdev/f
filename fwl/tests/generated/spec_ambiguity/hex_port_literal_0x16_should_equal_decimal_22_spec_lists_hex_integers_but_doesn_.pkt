name: "hex port literal 0x16 should equal decimal 22 — spec lists hex integers but doesn't explicitly say they work as port literals"
source_fw: |
  @xdp(eth0)
  allow if pkt.proto == tcp and pkt.dst_port == 0x16
  default drop

test_packet:
  builder: tcp(dst_port=22)

expected:
  compiles: true
  bpf_action: allow
