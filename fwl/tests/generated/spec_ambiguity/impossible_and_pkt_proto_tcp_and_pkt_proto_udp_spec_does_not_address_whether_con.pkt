name: "impossible AND pkt.proto==tcp and pkt.proto==udp — spec does not address whether contradictory guards still satisfy access requirements"
source_fw: |
  @xdp(eth0)
  drop if pkt.proto == tcp and pkt.proto == udp and pkt.tcp.syn
  default allow

test_packet:
  builder: tcp(syn=true)

expected:
  compiles: true
  bpf_action: allow
