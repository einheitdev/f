name: "OR-guard parenthesized — explicit parens force OR before AND so dst_port access is unguarded on tcp branch's exit-union"
source_fw: |
  @xdp(eth0)
  allow if (pkt.proto == tcp or pkt.proto == udp) and pkt.dst_port == 443
  default drop

test_packet:
  builder: tcp(dst_port=443)

expected:
  compiles: true
  bpf_action: allow
