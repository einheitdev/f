name: "OR-guard unparenthesized — spec example at 179-183 errors with self-contradictory rationale; semantics section says path-guarded access is fine"
source_fw: |
  @xdp(eth0)
  allow if pkt.proto == tcp or pkt.proto == udp and pkt.dst_port == 443
  default drop

test_packet:
  builder: udp(dst_port=443)

expected:
  compiles: true
  bpf_action: allow
