name: "rate_limit per=src_port on ICMP packet — spec is silent on bucket key when packet lacks the per= field"
source_fw: |
  @xdp(eth0)
  drop if pkt.proto == icmp
       limited by rate_limit(10, per=src_port)
  default allow

test_packet:
  builder: icmp()

expected:
  compiles: true
  bpf_action: drop
