name: "rate_limit with no if condition — spec line 263 'a rule may carry limited by without if'; should apply to every packet"
source_fw: |
  @xdp(eth0)
  drop limited by rate_limit(10, per=src_ip)
  default allow

state:
  rate_limit:
    0:
      "1.1.1.1": 5

test_packet:
  builder: tcp(src_ip="1.1.1.1", dst_port=80)

expected:
  compiles: true
  bpf_action: drop
